use jn "julenum"
use "julenum/internal/chunk"
use "std/comptime"

// Returns true when the slices have equal lengths and
// all elements are numerically identical.
#disable boundary
fn Equal[S: ~[]T, T: numeric](a: S, b: S): bool {
	if len(a) != len(b) {
		return false
	}
	mut i := 0
	for i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// Returns true when the slices have equal lengths and
// all element pairs have an absolute tolerance less than tol or a
// relative tolerance less than tol.
#disable boundary
fn EqualApprox[S: ~[]T, T: ~f64 | ~cmplx128](a: S, b: S, tol: f64): bool {
	if len(a) != len(b) {
		return false
	}
	const t = comptime::Typeof(T)
	const match t.Kind() {
	| comptime::F64:
		mut i := 0
		for i < len(a); i++ {
			if !jn::EqualWithinAbsOrRel(a[i], b[i], tol, tol) {
				return false
			}
		}
	| comptime::Cmplx128:
		mut i := 0
		for i < len(a); i++ {
			if !jn::EqualWithinAbsOrRel(real(a[i]), real(b[i]), tol, tol) ||
				!jn::EqualWithinAbsOrRel(imag(a[i]), imag(b[i]), tol, tol) {
				return false
			}
		}
	|:
		panic("unreachable")
	}
	return true
}

// Returns the sum of the elements of the slice.
//
// Formula:
//	sum = Σᵢ [ xᵢ ]
#disable boundary
fn Sum[S: ~[]T, T: numeric](x: S): T {
	let mut sum: T
	mut i := 0
	for i < len(x); i++ {
		sum += x[i]
	}
	return sum
}

// Sets z to the sum x+y and returning it.
// All slices must have same length.
//
// Formula:
//	zᵢ = xᵢ+yᵢ
fn Add[S: ~[]T, T: numeric](mut z: S, x: S, y: S): S {
	if len(z) != len(x) || len(z) != len(y) {
		panic("nums: Add: all slices must have same length")
	}
	chunk::Add(z, x, y)
	return z
}

// Sets z to the difference x-y and returning it.
// All slices must have same length.
//
// Formula:
//	zᵢ = xᵢ-yᵢ
fn Sub[S: ~[]T, T: numeric](mut z: S, x: S, y: S): S {
	if len(z) != len(x) || len(z) != len(y) {
		panic("nums: Sub: all slices must have same length")
	}
	chunk::Sub(z, x, y)
	return z
}

// Sets z to the product x*y and returning it.
// All slices must have same length.
//
// Formula:
//	zᵢ = xᵢ*yᵢ
fn Mul[S: ~[]T, T: numeric](mut z: S, x: S, y: S): S {
	if len(z) != len(x) || len(z) != len(y) {
		panic("nums: Mul: all slices must have same length")
	}
	chunk::Mul(z, x, y)
	return z
}

// Sets z to the product x/y and returning it.
// All slices must have same length.
//
// Formula:
//	zᵢ = xᵢ/yᵢ
fn Div[S: ~[]T, T: numeric](mut z: S, x: S, y: S): S {
	if len(z) != len(x) || len(z) != len(y) {
		panic("nums: Div: all slices must have same length")
	}
	chunk::Div(z, x, y)
	return z
}

// Sets z to the sum x+k and returning it.
// All slices must have same length.
//
// Formula:
//	zᵢ = xᵢ+k
fn AddScalar[S: ~[]T, T: numeric](mut z: S, x: S, k: T): S {
	if len(z) != len(x) {
		panic("nums: AddScalar: all slices must have same length")
	}
	chunk::AddScalar(z, x, k)
	return z
}