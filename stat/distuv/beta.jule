use jn "julenum"
use "std/math"
use "std/math/rand"

// Implements the Beta distribution, a two-parameter continuous distribution
// with support between 0 and 1.
//
// The beta distribution has density function
//
//	x^(α-1) * (1-x)^(β-1) * Γ(α+β) / (Γ(α)*Γ(β))
//
// For more information, see https://en.wikipedia.org/wiki/Beta_distribution
struct Beta {
	// The left shape parameter of the distribution. Alpha must be greater than 0.
	Alpha: f64

	// The right shape parameter of the distribution. Beta must be greater than 0.
	Beta: f64

	Rng: &rand::Rand
}

impl Beta {
	// Computes the value of the cumulative distribution function at x.
	fn CDF(*self, x: f64): f64 {
		if x <= 0 {
			return 0
		}
		if x >= 1 {
			return 1
		}
		return jn::RegIncBeta(self.Alpha, self.Beta, x)
	}

	// Returns the differential entropy of the distribution.
	fn Entropy(*self): f64 {
		if self.Alpha <= 0 || self.Beta <= 0 {
			panic("beta: negative parameters")
		}
		a, b := self.Alpha, self.Beta
		return jn::Lbeta(a, b) - (a-1)*jn::Digamma(a) -
			(b-1)*jn::Digamma(b) + (a+b-2)*jn::Digamma(a+b)
	}

	// Returns the excess kurtosis of the distribution.
	fn ExKurtosis(*self): f64 {
		a, b := self.Alpha, self.Beta
		num := 6 * ((a-b)*(a-b)*(a+b+1) - a*b*(a+b+2))
		den := a * b * (a + b + 2) * (a + b + 3)
		return num / den
	}

	// Computes the natural logarithm of the value of the probability
	// density function at x.
	fn LogProb(*self, x: f64): f64 {
		if x < 0 || x > 1 {
			return math::Inf(-1)
		}

		if self.Alpha <= 0 || self.Beta <= 0 {
			panic("beta: negative parameters")
		}

		lab, _ := math::Lgamma(self.Alpha + self.Beta)
		la, _ := math::Lgamma(self.Alpha)
		lb, _ := math::Lgamma(self.Beta)
		let mut lx: f64
		if self.Alpha != 1 {
			lx = (self.Alpha - 1) * math::Log(x)
		}
		let mut l1mx: f64
		if self.Beta != 1 {
			l1mx = (self.Beta - 1) * math::Log(1-x)
		}
		return lab - la - lb + lx + l1mx
	}

	// Returns the mean of the probability distribution.
	fn Mean(*self): f64 {
		return self.Alpha / (self.Alpha + self.Beta)
	}

	// Returns the mode of the distribution.
	//
	// Mode returns NaN if both parameters are less than or equal to 1 as a special case,
	// 0 if only Alpha <= 1 and 1 if only Beta <= 1.
	fn Mode(*self): f64 {
		if self.Alpha <= 1 {
			if self.Beta <= 1 {
				return math::NaN()
			}
			return 0
		}
		if self.Beta <= 1 {
			return 1
		}
		return (self.Alpha - 1) / (self.Alpha + self.Beta - 2)
	}

	// Returns the number of parameters in the distribution.
	fn NumParameters(*self): int {
		return 2
	}

	// Computes the value of the probability density function at x.
	fn Prob(*self, x: f64): f64 {
		return math::Exp(self.LogProb(x))
	}

	// Returns the inverse of the cumulative distribution function.
	fn Quantile(*self, p: f64): f64 {
		if p < 0 || p > 1 {
			panic(badPercentile)
		}
		return jn::InvRegIncBeta(self.Alpha, self.Beta, p)
	}

	// Returns a random sample drawn from the distribution.
	fn Rand(*self): f64 {
		ga := Gamma{Alpha: self.Alpha, Beta: 1, Rng: self.Rng}.Rand()
		gb := Gamma{Alpha: self.Beta, Beta: 1, Rng: self.Rng}.Rand()
		return ga / (ga + gb)
	}

	// Returns the standard deviation of the probability distribution.
	fn StdDev(*self): f64 {
		return math::Sqrt(self.Variance())
	}

	// Returns the survival function (complementary CDF) at x.
	fn Survival(*self, x: f64): f64 {
		match {
		| x <= 0:
			return 1
		| x >= 1:
			return 0
		}
		return jn::RegIncBeta(self.Beta, self.Alpha, 1-x)
	}

	// Variance returns the variance of the probability distribution.
	fn Variance(*self): f64 {
		a, b := self.Alpha, self.Beta
		return a * b / ((a + b) * (a + b) * (a + b + 1))
	}
}