use "std/math"
use "std/math/rand"

// Represents a random variable whose value is 1 with probability p and
// value of zero with probability 1-P. The value of P must be between 0 and 1.
// More information at https://en.wikipedia.org/wiki/Bernoulli_distribution.
struct Bernoulli {
	P:   f64
	Rng: &rand::Rand
}

impl Bernoulli {
	// Computes the value of the cumulative density function at x.
	fn CDF(*self, x: f64): f64 {
		if x < 0 {
			return 0
		}
		if x < 1 {
			return 1 - self.P
		}
		return 1
	}

	// Returns the entropy of the distribution.
	fn Entropy(*self): f64 {
		if self.P == 0 || self.P == 1 {
			return 0
		}
		q := 1 - self.P
		return -self.P*math::Log(self.P) - q*math::Log(q)
	}

	// Returns the excess kurtosis of the distribution.
	fn ExKurtosis(*self): f64 {
		pq := self.P * (1 - self.P)
		return (1 - 6*pq) / pq
	}

	// Computes the natural logarithm of the value of the probability density function at x.
	fn LogProb(*self, x: f64): f64 {
		if x == 0 {
			return math::Log(1 - self.P)
		}
		if x == 1 {
			return math::Log(self.P)
		}
		return math::Inf(-1)
	}

	// Returns the mean of the probability distribution.
	fn Mean(*self): f64 {
		return self.P
	}

	// Returns the median of the probability distribution.
	fn Median(*self): f64 {
		p := self.P
		match {
		| p < 0.5:
			return 0
		| p > 0.5:
			return 1
		|:
			return 0.5
		}
	}

	// Returns the number of parameters in the distribution.
	fn NumParameters(*self): int {
		return 1
	}

	// Computes the value of the probability distribution at x.
	fn Prob(*self, x: f64): f64 {
		if x == 0 {
			return 1 - self.P
		}
		if x == 1 {
			return self.P
		}
		return 0
	}

	// Returns the minimum value of x from amongst all those values whose CDF value exceeds or equals p.
	fn Quantile(*self, p: f64): f64 {
		if p < 0 || 1 < p {
			panic(badPercentile)
		}
		if p <= 1-self.P {
			return 0
		}
		return 1
	}

	// Returns a random sample drawn from the distribution.
	fn Rand(*self): f64 {
		let mut rnd: f64
		if self.Rng == nil {
			rnd = rand::F64()
		} else {
			rnd = self.Rng.F64()
		}
		if rnd < self.P {
			return 1
		}
		return 0
	}

	// Returns the skewness of the distribution.
	fn Skewness(*self): f64 {
		return (1 - 2*self.P) / math::Sqrt(self.P*(1-self.P))
	}

	// Returns the standard deviation of the probability distribution.
	fn StdDev(*self): f64 {
		return math::Sqrt(self.Variance())
	}

	// Returns the survival function (complementary CDF) at x.
	fn Survival(*self, x: f64): f64 {
		if x < 0 {
			return 1
		}
		if x < 1 {
			return self.P
		}
		return 0
	}

	// Returns the variance of the probability distribution.
	fn Variance(*self): f64 {
		return self.P * (1 - self.P)
	}
}