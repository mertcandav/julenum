use jn "julenum"
use "std/math"
use "std/math/rand"

// Implements the Poisson distribution, a discrete probability distribution
// that expresses the probability of a given number of events occurring in a fixed
// interval.
// The poisson distribution has density function:
//
//	f(k) = λ^k / k! e^(-λ)
//
// For more information, see https://en.wikipedia.org/wiki/Poisson_distribution.
struct Poisson {
	// The average number of events in an interval.
	// Lambda must be greater than 0.
	Lambda: f64

	Rng: &rand::Rand
}

impl Poisson {
	// Computes the value of the cumulative distribution function at x.
	fn CDF(*self, x: f64): f64 {
		if x < 0 {
			return 0
		}
		return jn::GammaIncRegComp(math::Floor(x+1), self.Lambda)
	}

	// Returns the excess kurtosis of the distribution.
	fn ExKurtosis(*self): f64 {
		return 1 / self.Lambda
	}

	// Computes the natural logarithm of the value of the probability
	// density function at x.
	fn LogProb(*self, x: f64): f64 {
		if x < 0 || math::Floor(x) != x {
			return math::Inf(-1)
		}
		lg, _ := math::Lgamma(math::Floor(x) + 1)
		return x*math::Log(self.Lambda) - self.Lambda - lg
	}

	// Returns the mean of the probability distribution.
	fn Mean(*self): f64 {
		return self.Lambda
	}

	// Returns the number of parameters in the distribution.
	fn NumParameters(*self): int {
		return 1
	}

	// Computes the value of the probability density function at x.
	fn Prob(*self, x: f64): f64 {
		return math::Exp(self.LogProb(x))
	}

	// Returns a random sample drawn from the distribution.
	fn Rand(*self): f64 {
		// NUMERICAL RECIPES IN C: THE ART OF SCIENTIFIC COMPUTING (ISBN 0-521-43108-5)
		// p. 294
		// <http://www.aip.de/groups/soe/local/numres/bookcpdf/c7-3.pdf>

		mut rnd := rand::ExpF64
		if self.Rng != nil {
			rnd = fn|| unsafe { self.Rng.ExpF64() }
		}

		if self.Lambda < 10.0 {
			// Use direct method.
			let mut em: f64
			mut t := 0.0
			for {
				t += rnd()
				if t >= self.Lambda {
					break
				}
				em++
			}
			return em
		}
		// Generate using:
		//  W. Hörmann. "The transformed rejection method for generating Poisson
		//  random variables." Insurance: Mathematics and Economics
		//  12.1 (1993): 39-45.

		// Algorithm PTRS
		rnd = rand::F64
		if self.Rng != nil {
			rnd = fn|| unsafe { self.Rng.F64() }
		}
		b := 0.931 + 2.53*math::Sqrt(self.Lambda)
		a := -0.059 + 0.02483*b
		invalpha := 1.1239 + 1.1328/(b-3.4)
		vr := 0.9277 - 3.6224/(b-2)
		for {
			U := rnd() - 0.5
			V := rnd()
			us := 0.5 - math::Abs(U)
			k := math::Floor((2*a/us+b)*U + self.Lambda + 0.43)
			if us >= 0.07 && V <= vr {
				return k
			}
			if k <= 0 || (us < 0.013 && V > us) {
				continue
			}
			lg, _ := math::Lgamma(k + 1)
			if math::Log(V*invalpha/(a/(us*us)+b)) <= k*math::Log(self.Lambda)-self.Lambda-lg {
				return k
			}
		}
	}

	// Returns the skewness of the distribution.
	fn Skewness(*self): f64 {
		return 1 / math::Sqrt(self.Lambda)
	}

	// Returns the standard deviation of the probability distribution.
	fn StdDev(*self): f64 {
		return math::Sqrt(self.Variance())
	}

	// Returns the survival function (complementary CDF) at x.
	fn Survival(*self, x: f64): f64 {
		return 1 - self.CDF(x)
	}

	// Returns the variance of the probability distribution.
	fn Variance(*self): f64 {
		return self.Lambda
	}
}