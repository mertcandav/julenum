use jn "julenum"
use "julenum/nums"
use "julenum/stat"
use "std/math"
use "std/math/rand"

// Instantiation of the normal distribution with Mu = 0 and Sigma = 1.
let UnitNormal = Normal{Mu: 0, Sigma: 1}

// Represents a normal (Gaussian) distribution (https://en.wikipedia.org/wiki/Normal_distribution).
struct Normal {
	Mu:    f64 // Mean of the normal distribution
	Sigma: f64 // Standard deviation of the normal distribution
	Rng:   &rand::Rand

	// Needs to be Mu and Sigma and not Mean and StdDev because Normal has functions
	// Mean and StdDev.
}

impl Normal {
	// Computes the value of the cumulative density function at x.
	fn CDF(*self, x: f64): f64 {
		return 0.5 * math::Erfc(-(x-self.Mu)/(self.Sigma*jn::Sqrt2))
	}

	// Updates the parameters of the distribution from the sufficient
	// statistics of a set of samples. The sufficient statistics, suffStat, have been
	// observed with nSamples observations. The prior values of the distribution are those
	// currently in the distribution, and have been observed with priorStrength samples.
	//
	// For the normal distribution, the sufficient statistics are the mean and
	// uncorrected standard deviation of the samples.
	// The prior is having seen strength[0] samples with mean Normal.Mu
	// and strength[1] samples with standard deviation Normal.Sigma. As a result of
	// this function, Normal.Mu and Normal.Sigma are updated based on the weighted
	// samples, and strength is modified to include the new number of samples observed.
	//
	// This function panics if len(suffStat) != Normal.NumSuffStat() or
	// len(priorStrength) != Normal.NumSuffStat().
	fn ConjugateUpdate(mut *self, suffStat: []f64, nSamples: f64, mut priorStrength: []f64) {
		// TODO: Support prior strength with math.Inf(1) to allow updating with
		// a known mean/standard deviation
		if len(suffStat) != self.NumSuffStat() {
			panic("norm: incorrect suffStat length")
		}
		if len(priorStrength) != self.NumSuffStat() {
			panic("norm: incorrect priorStrength length")
		}

		totalMeanSamples := nSamples + priorStrength[0]
		totalSum := suffStat[0]*nSamples + self.Mu*priorStrength[0]

		totalVarianceSamples := nSamples + priorStrength[1]
		// sample variance
		mut totalVariance := nSamples * suffStat[1] * suffStat[1]
		// add prior variance
		totalVariance += priorStrength[1] * self.Sigma * self.Sigma
		// add cross variance from the difference of the means
		meanDiff := (suffStat[0] - self.Mu)
		totalVariance += priorStrength[0] * nSamples * meanDiff * meanDiff / totalMeanSamples

		self.Mu = totalSum / totalMeanSamples
		self.Sigma = math::Sqrt(totalVariance / totalVarianceSamples)
		nums::AddScalar(priorStrength, priorStrength, nSamples)
	}

	// Returns the differential entropy of the distribution.
	fn Entropy(*self): f64 {
		return 0.5 * (jn::Log2Pi + 1 + 2*math::Log(self.Sigma))
	}

	// Returns the excess kurtosis of the distribution.
	fn ExKurtosis(*self): f64 {
		return 0
	}

	// Sets the parameters of the probability distribution from the
	// data samples x with relative weights w. If weights is nil, then all the weights
	// are 1. If weights is not nil, then the len(weights) must equal len(samples).
	fn Fit(mut *self, samples: []f64, weights: []f64) {
		mut suffStat := make([]f64, self.NumSuffStat())
		nSamples := self.SuffStat(suffStat, samples, weights)
		self.ConjugateUpdate(suffStat, nSamples, make([]f64, self.NumSuffStat()))
	}

	// Computes the natural logarithm of the value of the probability density function at x.
	fn LogProb(*self, x: f64): f64 {
		return -jn::LogRoot2Pi - math::Log(self.Sigma) - (x-self.Mu)*(x-self.Mu)/(2*self.Sigma*self.Sigma)
	}

	// Returns the mean of the probability distribution.
	fn Mean(*self): f64 {
		return self.Mu
	}

	// Returns the median of the normal distribution.
	fn Median(*self): f64 {
		return self.Mu
	}

	// Returns the mode of the normal distribution.
	fn Mode(*self): f64 {
		return self.Mu
	}

	// Returns the number of parameters in the distribution.
	fn NumParameters(*self): int {
		return 2
	}

	// Returns the number of sufficient statistics for the distribution.
	fn NumSuffStat(*self): int {
		return 2
	}

	// Computes the value of the probability density function at x.
	fn Prob(*self, x: f64): f64 {
		return math::Exp(self.LogProb(x))
	}

	// Returns the inverse of the cumulative probability distribution.
	fn Quantile(*self, p: f64): f64 {
		if p < 0 || p > 1 {
			panic(badPercentile)
		}
		return self.Mu + self.Sigma*jn::NormalQuantile(p)
	}

	// Returns a random sample drawn from the distribution.
	fn Rand(*self): f64 {
		let mut rnd: f64
		if self.Rng == nil {
			rnd = rand::NormF64()
		} else {
			rnd = self.Rng.NormF64()
		}
		return rnd*self.Sigma + self.Mu
	}

	// Returns the score function with respect to the parameters of the
	// distribution at the input location x. The score function is the derivative
	// of the log-likelihood at x with respect to the parameters
	//
	//	(∂/∂θ) log(p(x;θ))
	//
	// If deriv is non-nil, len(deriv) must equal the number of parameters otherwise
	// Score will panic, and the derivative is stored in-place into deriv. If deriv
	// is nil a new slice will be allocated and returned.
	//
	// The order is [∂LogProb / ∂Mu, ∂LogProb / ∂Sigma].
	//
	// For more information, see https://en.wikipedia.org/wiki/Score_%28statistics%29.
	fn Score(*self, mut deriv: []f64, x: f64): []f64 {
		if deriv == nil {
			deriv = make([]f64, self.NumParameters())
		}
		if len(deriv) != self.NumParameters() {
			panic(badLength)
		}
		mu, sigma := self.Mu, self.Sigma
		xmus := (x - mu) / sigma
		deriv[0] = (x - mu) / (sigma * sigma)
		deriv[1] = 1 / sigma * (-1 + xmus*xmus)
		return deriv
	}

	// Returns the score function with respect to the input of the
	// distribution at the input location specified by x. The score function is the
	// derivative of the log-likelihood
	//
	//	(d/dx) log(p(x)) .
	fn ScoreInput(*self, x: f64): f64 {
		return -(1 / (2 * self.Sigma * self.Sigma)) * 2 * (x - self.Mu)
	}

	// Returns the skewness of the distribution.
	fn Skewness(*self): f64 {
		return 0
	}

	// Returns the standard deviation of the probability distribution.
	fn StdDev(*self): f64 {
		return self.Sigma
	}

	// Computes the sufficient statistics of a set of samples to update
	// the distribution. The sufficient statistics are stored in place, and the
	// effective number of samples are returned.
	//
	// The normal distribution has two sufficient statistics, the mean of the samples
	// and the standard deviation of the samples.
	//
	// If weights is nil, the weights are assumed to be 1, otherwise panics if
	// len(samples) != len(weights). Panics if len(suffStat) != NumSuffStat().
	fn SuffStat(*self, mut suffStat: []f64, samples: []f64, weights: []f64): (nSamples: f64) {
		lenSamp := len(samples)
		if len(weights) != 0 && len(samples) != len(weights) {
			panic(badLength)
		}
		if len(suffStat) != (Normal{}).NumSuffStat() {
			panic(badSuffStat)
		}

		if len(weights) == 0 {
			nSamples = f64(lenSamp)
		} else {
			nSamples = nums::Sum(weights)
		}

		mean := stat::Mean(samples, weights)
		suffStat[0] = mean

		// Use Moment and not StdDev because we want it to be uncorrected
		variance := stat::MomentAbout(2, samples, mean, weights)
		suffStat[1] = math::Sqrt(variance)
		return nSamples
	}

	// Returns the survival function (complementary CDF) at x.
	fn Survival(*self, x: f64): f64 {
		return 0.5 * (1 - math::Erf((x-self.Mu)/(self.Sigma*jn::Sqrt2)))
	}

	// Returns the variance of the probability distribution.
	fn Variance(*self): f64 {
		return self.Sigma * self.Sigma
	}
}