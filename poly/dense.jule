use jn "julenum"
use "julenum/internal/fourier"
use "julenum/internal/ibits"
use "julenum/internal/imem"
use "std/math"

// Represents a polynomial by storing all coefficients from the
// constant term to the highest-degree term.
//
// For a polynomial:
//
//	P(x) = a₀ + a₁*x + a₂*x² + ... + aₙ*xⁿ
//
// the coefficient at index i is the coefficient of xⁱ.
//
// For example:
//
//	3x² - 4x + 7 -> Dense{7, -4, 3}
//
// The zero polynomial is represented by an empty slice.
//
// Coefficients are stored in ascending order of exponent:
//	coefficients[0] = coefficient of x⁰
//	coefficients[1] = coefficient of x¹
//	...
//	coefficients[n] = coefficient of xⁿ
//
// The last coefficient must be non-zero for a non-zero polynomial.
// Any corruption of this invariant is undefined behavior.
//
// Capacity of the underlying slice is never changed for values;
// i.e. there are no 3-operand slice expressions.
// Any corruption of this rule is undefined behavior.
type Dense: []f64

impl Dense {
	// Returns a new Dense buffer enough to store at least n values.
	fn make(mut *self, n: int): Dense {
		// Reuse self capacity, if there is enough space.
		if n <= cap(*self) {
			return (*self)[:n]
		}
		return make(Dense, n)
	}

	// Sets self to the given coefficients.
	//
	// Coefficients are ordered by increasing exponent, where
	// coefficients[i] is the coefficient of xⁱ.
	//
	// Coefficients that are zero within tolerance are removed.
	// Since Dense stores coefficients by exponent, removing an
	// interior coefficient means setting it to zero, while trailing
	// zero coefficients are removed from the representation.
	//
	// The resulting polynomial is always in simplified canonical form.
	//
	// If self has enough capacity, Set will reuse it to avoid allocation.
	// If coefficients is empty, self will be zero-length but keeps its
	// capacity.
	#disable boundary
	fn Set(mut *self, coefficients: []f64, tol: f64) {
		n := len(coefficients)

		if n == 0 {
			*self = (*self)[:0]
			return
		}

		*self = self.make(n)
		copy(*self, coefficients)

		// Remove coefficients that are zero within tolerance.
		mut i := 0
		for i < n; i++ {
			if jn::Tolerance((*self)[i], 0, tol) {
				(*self)[i] = 0
			}
		}

		// Remove trailing zero coefficients.
		i = n
		for i > 0 && (*self)[i-1] == 0 {
			i--
		}

		*self = (*self)[:i]
	}

	// Sets self to simplified form of polynomial p.
	//
	// Coefficients that are zero within tolerance are set to zero.
	// Trailing zero coefficients are removed.
	//
	// Result is stored in canonical Dense representation:
	// the zero polynomial has length zero, and the highest-degree
	// coefficient of a non-zero polynomial is non-zero.
	//
	// If self has enough capacity, Simplify will use it to avoid
	// making allocation. If length is zero, self will be zero-length
	// but keeps its internal allocation.
	fn Simplify(mut *self, &p: *Dense, tol: f64) {
		self.Set([]f64(*p), tol)
	}

	// Returns the leading coefficient of the polynomial.
	// Panics if polynomial is zero.
	fn LeadingCoef(*self): f64 {
		if len(*self) == 0 {
			panic("poly: LeadingCoef called on zero polynomial")
		}
		return (*self)[len(*self)-1]
	}

	// Reports whether polynomial is zero within tolerance.
	fn Zero(*self, tol: f64): bool {
		return len(*self) == 0 || jn::Tolerance((*self)[len(*self)-1], 0, tol)
	}

	// Returns the degree of the polynomial (highest exponent).
	// Returns -1 for the zero polynomial.
	fn Degree(*self): int {
		if len(*self) == 0 {
			return -1
		}
		return len(*self) - 1
	}

	// Sets self to negated coefficients of the polynomial x.
	// For example, (3x^2 - 4x + 1) becomes (-3x^2 + 4x - 1).
	//
	// If self has enough capacity, Negate will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Negate(mut *self, &x: *Dense) {
		*self = self.make(len(*x))
		for i, coef in *x {
			(*self)[i] = -coef
		}
	}

	// Copies polynomial x to self.
	//
	// If self has enough capacity, Copy will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn Copy(mut *self, &x: *Dense) {
		// self is x, return immediately.
		if self == x {
			return
		}
		*self = self.make(len(*x))
		copy(*self, *x)
	}

	// Sets self to sum x+y.
	//
	// If self has enough capacity, Add will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable nilptr boundary
	fn Add(mut *self, &x: *Dense, &y: *Dense, tol: f64) {
		// Due to disabling nilptr checks, we have to check manually.
		if self == nil {
			panic("Dense.Add: self receiver is nil")
		}
		if x == nil {
			panic("Dense.Add: x is nil")
		}
		if y == nil {
			panic("Dense.Add: y is nil")
		}

		n := ibits::Max(len(*x), len(*y))
		*self = self.make(n)

		mut i := 0
		for i < n {
			mut coef := f64(0)
			if i < len(*x) {
				coef += (*x)[i]
			}
			if i < len(*y) {
				coef += (*y)[i]
			}
			(*self)[i] = coef
			i++
		}
	}

	// Sets self to difference x-y.
	//
	// If self has enough capacity, Sub will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable nilptr boundary
	fn Sub(mut *self, &x: *Dense, &y: *Dense, tol: f64) {
		// Due to disabling nilptr checks, we have to check manually.
		if self == nil {
			panic("Dense.Add: self receiver is nil")
		}
		if x == nil {
			panic("Dense.Add: x is nil")
		}
		if y == nil {
			panic("Dense.Add: y is nil")
		}

		n := ibits::Max(len(*x), len(*y))
		*self = self.make(n)

		mut i := 0
		for i < n {
			mut coef := f64(0)
			if i < len(*x) {
				coef = (*x)[i]
			}
			if i < len(*y) {
				coef -= (*y)[i]
			}
			(*self)[i] = coef
			i++
		}
	}

	// Sets self to scaled coefficients of x by scalar k.
	// For example, if k = 2, (3x^2 - x) becomes (6x^2 - 2x).
	//
	// If self have enough capacity, Scale will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Scale(mut *self, &x: *Dense, k: f64, tol: f64) {
		if len(*x) == 0 {
			// self is an alias for x, return immediately.
			if self == x {
				return
			}
			*self = self.make(0)
			return
		}

		if k == 0 {
			*self = (*self)[:0]
			return
		}

		*self = self.make(len(*x))

		mut i := 0
		for _, coef in *x {
			scaled := coef * k
			if !jn::Tolerance(scaled, 0, tol) {
				(*self)[i] = scaled
				i++
			} else {
				// Preserve the exponent position in Dense.
				(*self)[i] = 0
				i++
			}
		}

		// Remove trailing zero coefficients.
		mut n := len(*self)
		for n > 0 && (*self)[n-1] == 0 {
			n--
		}
		*self = (*self)[:n]
	}

	// Sets self to product x*y.
	//
	// It is equivalent to MulTol(x, y, tol), but determines tolerance dynamically.
	// Dynamic tolerance value might not be suitable for some cases.
	// Use MulTol with custom tolerance when needed, especially for precise
	// and small coefficients like 1e-14.
	//
	// For minimum rounding-errors, use MulNaive to force native algorithms.
	// Naive algorithm is slower than FFT, but it is more accurate.
	//
	// If self have enough capacity, Mul will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Mul(mut *self, &x: *Dense, &y: *Dense) {
		// Early return: x or y is zero.
		if len(*x) == 0 || len(*y) == 0 {
			*self = (*self)[:0]
			return
		}

		// Small and medium-sized polynomials are better handled
		// directly. FFT becomes useful for sufficiently large inputs.
		size := len(*x) + len(*y) - 1

		if size <= 64 {
			denseMulNaive(self, x, y)
			return
		}

		if size <= 4096 {
			denseMulNaive(self, x, y)
			return
		}

		tol := denseDynamicTolerance(x, y, size)
		denseMulFFT(self, x, y, size, tol)
	}

	// Sets self to product x*y.
	//
	// Like Mul but forces the naive algorithm and never uses FFT.
	// Provides more accurate results, but slower for large polynomials.
	//
	// If self have enough capacity, MulNaive will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn MulNaive(mut *self, &x: *Dense, &y: *Dense) {
		// Early return: x or y is zero.
		if len(*x) == 0 || len(*y) == 0 {
			*self = (*self)[:0]
			return
		}

		denseMulNaive(self, x, y)
	}

	// Sets self to product x*y.
	//
	// Unlike Mul, this function takes custom tolerance and uses it for FFT.
	// If the naive algorithm is selected, tolerance is not used.
	//
	// The algorithm selects between naive multiplication and FFT
	// depending on polynomial size.
	//
	// If self have enough capacity, MulTol will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn MulTol(mut *self, &x: *Dense, &y: *Dense, tol: f64) {
		// Early return: x or y is zero.
		if len(*x) == 0 || len(*y) == 0 {
			*self = (*self)[:0]
			return
		}

		size := len(*x) + len(*y) - 1

		// Naive multiplication is preferable for small inputs.
		if size <= 4096 {
			denseMulNaive(self, x, y)
			return
		}

		denseMulFFT(self, x, y, size, tol)
	}

	// Sets self to product x*y.
	//
	// Like MulTol but forces FFT and never uses the naive algorithm.
	// Provides faster computations for large polynomials, but may introduce
	// more floating-point rounding errors.
	//
	// If self have enough capacity, MulFFT will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn MulFFT(mut *self, &x: *Dense, &y: *Dense, tol: f64) {
		// Early return: x or y is zero.
		if len(*x) == 0 || len(*y) == 0 {
			*self = (*self)[:0]
			return
		}

		size := len(*x) + len(*y) - 1
		denseMulFFT(self, x, y, size, tol)
	}

	// Sets self to quotient x/y, sets rem to remainder x/y if it is not nil.
	// Panics for divide by zero.
	//
	// It uses naive division for small inputs and FFT division for larger inputs.
	// FFT division may have larger floating-point rounding errors.
	//
	// If self and rem have enough capacity, DivMod will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn DivMod(mut *self, &x: *Dense, &y: *Dense, mut &rem: *Dense) {
		if len(*y) == 0 {
			panic("poly: division by zero")
		}

		if (*y)[len(*y)-1] == 0 {
			panic("poly: leading coefficient of divisor is zero")
		}

		mut kind := selectDivAlgorithm(x, y)
		kind = 1

		if rem != nil {
			match kind {
			| 0:
				denseBasicDivMod(self, x, y, rem)
			|:
				denseFFTDivMod(self, x, y, rem)
			}
		} else {
			let mut _rem: Dense
			match kind {
			| 0:
				denseBasicDivMod(self, x, y, &_rem)
			|:
				denseFFTDivMod(self, x, y, &_rem)
			}
		}
	}

	// Sets self to quotient x/y, sets rem to remainder x/y if it is not nil.
	//
	// Like DivMod but forces naive polynomial division and never uses FFT.
	//
	// If self and rem have enough capacity, DivModNaive will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn DivModNaive(mut *self, &x: *Dense, &y: *Dense, mut &rem: *Dense) {
		if len(*y) == 0 {
			panic("poly: division by zero")
		}

		if (*y)[len(*y)-1] == 0 {
			panic("poly: leading coefficient of divisor is zero")
		}

		if rem != nil {
			denseBasicDivMod(self, x, y, rem)
		} else {
			let mut _rem: Dense
			denseBasicDivMod(self, x, y, &_rem)
		}
	}

	// Sets self to the first derivative of polynomial x.
	//
	//	If x = ∑ᵢ [ aᵢ * xⁱ ], then self = ∑ᵢ [ (i*aᵢ)·xⁱ⁻¹ ] for i ≥ 1.
	//
	// Constant terms (exp = 0) are omitted.
	//
	// If self have enough capacity, Deriv will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Deriv(mut *self, &x: *Dense) {
		if len(*x) <= 1 {
			*self = (*self)[:0]
			return
		}

		*self = self.make(len(*x) - 1)

		mut i := 1
		for i < len(*x) {
			(*self)[i-1] = f64(i) * (*x)[i]
			i++
		}
	}

	// Sets self to the indefinite integral of polynomial x with constant term C.
	// That is, integrates each term and appends a constant term.
	//
	// If self have enough capacity, Integral will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	// #disable boundary
	#disable boundary
	fn Integral(mut *self, &x: *Dense, C: f64) {
		if len(*x) == 0 {
			if C == 0 {
				*self = (*self)[:0]
				return
			}

			*self = self.make(1)
			(*self)[0] = C
			return
		}

		*self = self.make(len(*x) + 1)
		(*self)[0] = C

		mut i := 0
		for i < len(*x) {
			(*self)[i+1] = (*x)[i] / f64(i+1)
			i++
		}

		// Remove trailing zero coefficients.
		mut n := len(*self)
		for n > 0 && (*self)[n-1] == 0 {
			n--
		}
		*self = (*self)[:n]
	}

	// Evaluates the polynomial at a given x.
	#disable boundary
	fn Eval(*self, x: f64): f64 {
		if len(*self) == 0 {
			return 0
		}

		mut result := (*self)[len(*self)-1]
		mut i := len(*self) - 1

		for i > 0 {
			i--
			result = result*x + (*self)[i]
		}

		return result
	}

	// Sets self to a rescaled polynomial x, so that its leading coefficient is 1.
	// If the polynomial is zero or its leading coefficient is very small, output
	// length is zero.
	//
	// If self have enough capacity, Normalize will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	// #disable boundary
	#disable boundary
	fn Normalize(mut *self, &x: *Dense, tol: f64) {
		if len(*x) == 0 {
			*self = (*self)[:0]
			return
		}

		// Find the actual leading coefficient, ignoring trailing zeros.
		mut n := len(*x)
		for n > 0 && (*x)[n-1] == 0 {
			n--
		}

		if n == 0 {
			*self = (*self)[:0]
			return
		}

		lead := (*x)[n-1]

		// A very small leading coefficient is treated as zero.
		if jn::Tolerance(lead, 0, tol) {
			*self = (*self)[:0]
			return
		}

		// self may alias x, so normalization is performed in-place.
		*self = self.make(n)

		mut i := 0
		for i < n {
			(*self)[i] = (*x)[i] / lead
			i++
		}
	}

	// Sets self to the unique linear polynomial that passes through points (x0, y0) and (x1, y1).
	//
	// The resulting coefficients are stored in ascending order:
	// self[0] = constant term, self[1] = x coefficient.
	//
	// If self have enough capacity, InterpolateLinear will use it to avoid making allocation.
	#disable boundary
	fn InterpolateLinear(mut *self, x0: f64, y0: f64, x1: f64, y1: f64) {
		if x0 == x1 {
			panic("poly: InterpolateLinear: x0 and x1 must be distinct")
		}

		// Compute slope and intercept.
		slope := (y1 - y0) / (x1 - x0)
		intercept := y0 - slope*x0

		*self = self.make(2)
		(*self)[0] = intercept
		(*self)[1] = slope
	}
}

// z = x*y using the native O(n²) convolution algorithm.
#disable boundary
fn denseMulNaive(mut &z: *Dense, &x: *Dense, &y: *Dense) {
	if len(*x) == 0 || len(*y) == 0 {
		*z = (*z)[:0]
		return
	}

	size := len(*x) + len(*y) - 1

	// If z aliases x or y, writing the result directly into z would
	// overwrite input coefficients before they are consumed.
	if denseAlias(z, x) || denseAlias(z, y) {
		mut result := make(Dense, size)

		for i, a in *x {
			if a == 0 {
				continue
			}

			for j, b in *y {
				if b == 0 {
					continue
				}

				result[i+j] += a * b
			}
		}

		// Remove trailing exact zeros.
		mut n := size
		for n > 0 && result[n-1] == 0 {
			n--
		}

		*z = result[:n]
		return
	}

	*z = z.make(size)

	// Clear the result because the backing storage may be reused.
	mut i := 0
	for i < size {
		(*z)[i] = 0
		i++
	}

	for k, a in *x {
		if a == 0 {
			continue
		}

		for j, b in *y {
			if b == 0 {
				continue
			}

			(*z)[k+j] += a * b
		}
	}

	// Remove trailing exact zeros.
	mut n := size
	for n > 0 && (*z)[n-1] == 0 {
		n--
	}

	*z = (*z)[:n]
}

// z = x*y using FFT convolution.
#disable boundary
fn denseMulFFT(mut &z: *Dense, &x: *Dense, &y: *Dense, size: int, tol: f64) {
	fftSize := ibits::NextPowerOfTwo(size)

	// One allocation for both complex coefficient arrays.
	mut workspace := make([]cmplx128, fftSize<<1)
	mut fa, mut fb := workspace[:fftSize], workspace[fftSize:]

	// Copy real coefficients into the complex arrays.
	for i, coef in *x {
		fa[i] = cmplx(coef, 0)
	}

	for i, coef in *y {
		fb[i] = cmplx(coef, 0)
	}

	// Forward FFT.
	fourier::FuseFFT(fa, fb, false)

	// Point-wise multiplication.
	for i in fa {
		fa[i] *= fb[i]
	}

	// Inverse FFT.
	fourier::FFT(fa, true)

	// Store only the mathematically required coefficient range.
	*z = z.make(size)

	mut n := size

	// Coefficients generated by FFT can contain tiny numerical noise.
	// Apply the caller-provided tolerance here.
	mut i := 0
	for i < size; i++ {
		coef := real(fa[i])

		if jn::Tolerance(coef, 0, tol) {
			(*z)[i] = 0
		} else {
			(*z)[i] = coef
		}
	}

	// Dense representation must not contain trailing zero coefficients.
	for n > 0 && (*z)[n-1] == 0 {
		n--
	}

	*z = (*z)[:n]
}

#disable boundary
fn denseDynamicTolerance(&x: *Dense, &y: *Dense, size: int): f64 {
	const (
		machineEpsilon = 2.22e-16
		safetyFactor   = 10000000.0
		smallThreshold = 200
	)

	mut maxCoef := 0.0

	for _, coef in *x {
		absCoef := math::Abs(coef)
		if absCoef > maxCoef {
			maxCoef = absCoef
		}
	}

	for _, coef in *y {
		absCoef := math::Abs(coef)
		if absCoef > maxCoef {
			maxCoef = absCoef
		}
	}

	if maxCoef == 0 {
		return 0
	}

	if size < smallThreshold {
		basicTol := machineEpsilon * f64(size) * maxCoef
		relativeTol := 1e-14 * maxCoef
		absoluteTol := 1e-16

		return math::Max(
			basicTol,
			math::Max(relativeTol, absoluteTol))
	}

	return machineEpsilon *
		f64(size) *
		math::Log2(f64(size)) *
		safetyFactor
}

fn selectDivAlgorithm(&x: *Dense, &y: *Dense): int {
	if len(*x) == 0 || len(*y) == 0 {
		return 0
	}

	degX := len(*x) - 1
	degY := len(*y) - 1

	// No quotient is required when deg(x) < deg(y).
	if degX < degY {
		return 0
	}

	quotientSize := degX - degY + 1

	// Naive division is preferable for small problems.
	if quotientSize <= 64 || len(*y) <= 32 {
		return 0
	}

	return 1
}

// Computes d such that c*d = 1 (mod x^k).
fn denseInverse(mut &inv: *Dense, &c: *Dense, k: int, tol: f64) {
	if k == 0 {
		*inv = (*inv)[:0]
		return
	}

	mut c0 := 0.0
	if len(*c) > 0 {
		c0 = (*c)[0]
	}

	if jn::Tolerance(c0, 0, tol) {
		panic("poly: constant zero term is illegal for inverse")
	}

	*inv = inv.make(1)
	(*inv)[0] = 1.0 / c0

	if k == 1 {
		return
	}

	mut m := 1

	for m < k {
		mut next := m * 2
		if next > k {
			next = k
		}

		// temp = c * inv mod x^next
		let mut temp: Dense
		temp.MulFFT(c, inv, tol)
		denseTruncate(&temp, next)

		// temp = 2 - c*inv
		temp[0] = 2 - temp[0]
		mut i := 1
		for i < len(temp); i++ {
			temp[i] = -temp[i]
		}

		// inv = inv * temp mod x^next
		let mut nextInv: Dense
		nextInv.MulFFT(inv, &temp, tol)
		denseTruncate(&nextInv, next)

		*inv = nextInv
		m = next
	}
}

fn denseTruncate(mut &x: *Dense, k: int) {
	if len(*x) > k {
		*x = (*x)[:k]
	}
}

fn denseReverse(mut &rev: *Dense, &p: *Dense) {
	n := len(*p)

	*rev = rev.make(n)

	mut i := 0
	for i < n; i++ {
		(*rev)[i] = (*p)[n-1-i]
	}
}

fn denseDivisionTolerance(&x: *Dense, &y: *Dense): f64 {
	const machineEpsilon = 2.22e-16

	size := len(*x) + len(*y)

	mut maxCoef := 0.0

	for _, c in *x {
		v := math::Abs(c)
		if v > maxCoef {
			maxCoef = v
		}
	}

	for _, c in *y {
		v := math::Abs(c)
		if v > maxCoef {
			maxCoef = v
		}
	}

	if maxCoef == 0 {
		return 0
	}

	return machineEpsilon * f64(size) * maxCoef * 100
}

fn denseZero(&p: *Dense, tol: f64): bool {
	for _, coef in *p {
		if !jn::Tolerance(coef, 0, tol) {
			return false
		}
	}
	return true
}

#disable boundary
fn denseFFTDivMod(mut &q: *Dense, &a: *Dense, &b: *Dense, mut &r: *Dense) {
	if len(*b) == 0 {
		panic("poly: division by zero")
	}

	degB := len(*b) - 1
	if (*b)[degB] == 0 {
		panic("poly: leading coefficient of divisor is zero")
	}

	if len(*a) == 0 {
		*q = (*q)[:0]

		if r != nil {
			*r = (*r)[:0]
		}

		return
	}

	degA := len(*a) - 1

	if degA < degB {
		*q = (*q)[:0]

		if r != nil {
			*r = r.make(len(*a))
			copy(*r, *a)
		}

		return
	}

	k := degA - degB + 1

	// Reverse a and b.
	let mut aRev: Dense
	denseReverse(&aRev, a)

	let mut bRev: Dense
	denseReverse(&bRev, b)

	// Compute inverse of reversed divisor modulo x^k.
	let mut invB: Dense
	denseInverse(&invB, &bRev, k, 0)

	// qRev = aRev * invB mod x^k.
	let mut qRev: Dense
	qRev.MulFFT(&aRev, &invB, 0)
	denseTruncate(&qRev, k)

	// Reverse qRev to obtain q.
	denseReverse(q, &qRev)

	// qb = q * b.
	let mut qb: Dense
	qb.MulFFT(q, b, 0)

	tol := denseDivisionTolerance(a, b)

	// r = a - qb.
	r.Sub(a, &qb, tol)

	// Remainder degree must be less than degB.
	denseTruncate(r, degB)

	if denseZero(r, tol) {
		*r = (*r)[:0]
	}
}

#disable boundary
fn denseBasicDivMod(mut &z: *Dense, &x: *Dense, &y: *Dense, mut &rem: *Dense) {
	if len(*y) == 0 {
		panic("poly: division by zero")
	}

	degY := len(*y) - 1
	coefY := (*y)[degY]

	if coefY == 0 {
		panic("poly: leading coefficient of divisor is zero")
	}

	if len(*x) == 0 {
		*z = (*z)[:0]
		if rem != nil {
			*rem = (*rem)[:0]
		}
		return
	}

	degX := len(*x) - 1

	if degX < degY {
		*z = (*z)[:0]

		if rem != nil {
			*rem = rem.make(len(*x))
			copy(*rem, *x)
		}

		return
	}

	quotLen := degX - degY + 1

	// Preserve the dividend because z/rem may alias x.
	mut work := make(Dense, len(*x))
	copy(work, *x)

	*z = z.make(quotLen)

	mut remDeg := degX
	for remDeg >= degY; remDeg-- {
		expDiff := remDeg - degY
		coefQuot := work[remDeg] / coefY

		(*z)[expDiff] = coefQuot

		mut i := 0
		for i <= degY; i++ {
			work[i+expDiff] -= coefQuot * (*y)[i]
		}
	}

	if rem != nil {
		if degY == 0 {
			*rem = (*rem)[:0]
			return
		}

		*rem = rem.make(degY)
		copy(*rem, work[:degY])
	}
}

// Reports whether x and y share the same base array.
//
// Note: alias assumes that the capacity of underlying arrays
// is never changed for values; i.e. that there are
// no 3-operand slice expressions in this code (or worse,
// reflect-based operations to the same effect).
fn denseAlias(&x: *Dense, &y: *Dense): bool {
	return imem::Alias([]f64(*x), []f64(*y))
}