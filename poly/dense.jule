use jn "julenum"
use "julenum/internal/ibits"

// Represents a polynomial by storing all coefficients from the
// constant term to the highest-degree term.
//
// For a polynomial:
//
//	P(x) = a₀ + a₁*x + a₂*x² + ... + aₙ*xⁿ
//
// the coefficient at index i is the coefficient of xⁱ.
//
// For example:
//
//	3x² - 4x + 7 -> Dense{7, -4, 3}
//
// The zero polynomial is represented by an empty slice.
//
// Coefficients are stored in ascending order of exponent:
//	coefficients[0] = coefficient of x⁰
//	coefficients[1] = coefficient of x¹
//	...
//	coefficients[n] = coefficient of xⁿ
//
// The last coefficient must be non-zero for a non-zero polynomial.
// Any corruption of this invariant is undefined behavior.
//
// Capacity of the underlying slice is never changed for values;
// i.e. there are no 3-operand slice expressions.
// Any corruption of this rule is undefined behavior.
type Dense: []f64

impl Dense {
	// Returns a new Dense buffer enough to store at least n values.
	fn make(mut *self, n: int): Dense {
		// Reuse self capacity, if there is enough space.
		if n <= cap(*self) {
			return (*self)[:n]
		}
		return make(Dense, n)
	}

	// Sets self to the given coefficients.
	//
	// Coefficients are ordered by increasing exponent, where
	// coefficients[i] is the coefficient of xⁱ.
	//
	// Coefficients that are zero within tolerance are removed.
	// Since Dense stores coefficients by exponent, removing an
	// interior coefficient means setting it to zero, while trailing
	// zero coefficients are removed from the representation.
	//
	// The resulting polynomial is always in simplified canonical form.
	//
	// If self has enough capacity, Set will reuse it to avoid allocation.
	// If coefficients is empty, self will be zero-length but keeps its
	// capacity.
	#disable boundary
	fn Set(mut *self, coefficients: []f64, tol: f64) {
		n := len(coefficients)

		if n == 0 {
			*self = (*self)[:0]
			return
		}

		*self = self.make(n)
		copy(*self, coefficients)

		// Remove coefficients that are zero within tolerance.
		mut i := 0
		for i < n; i++ {
			if jn::Tolerance((*self)[i], 0, tol) {
				(*self)[i] = 0
			}
		}

		// Remove trailing zero coefficients.
		i = n
		for i > 0 && (*self)[i-1] == 0 {
			i--
		}

		*self = (*self)[:i]
	}

	// Sets self to simplified form of polynomial p.
	//
	// Coefficients that are zero within tolerance are set to zero.
	// Trailing zero coefficients are removed.
	//
	// Result is stored in canonical Dense representation:
	// the zero polynomial has length zero, and the highest-degree
	// coefficient of a non-zero polynomial is non-zero.
	//
	// If self has enough capacity, Simplify will use it to avoid
	// making allocation. If length is zero, self will be zero-length
	// but keeps its internal allocation.
	fn Simplify(mut *self, &p: *Dense, tol: f64) {
		self.Set([]f64(*p), tol)
	}

	// Returns the leading coefficient of the polynomial.
	// Panics if polynomial is zero.
	fn LeadingCoef(*self): f64 {
		if len(*self) == 0 {
			panic("poly: LeadingCoef called on zero polynomial")
		}
		return (*self)[len(*self)-1]
	}

	// Reports whether polynomial is zero within tolerance.
	fn Zero(*self, tol: f64): bool {
		return len(*self) == 0 || jn::Tolerance((*self)[len(*self)-1], 0, tol)
	}

	// Returns the degree of the polynomial (highest exponent).
	// Returns -1 for the zero polynomial.
	fn Degree(*self): int {
		if len(*self) == 0 {
			return -1
		}
		return len(*self) - 1
	}

	// Sets self to negated coefficients of the polynomial x.
	// For example, (3x^2 - 4x + 1) becomes (-3x^2 + 4x - 1).
	//
	// If self has enough capacity, Negate will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Negate(mut *self, &x: *Dense) {
		*self = self.make(len(*x))
		for i, coef in *x {
			(*self)[i] = -coef
		}
	}

	// Copies polynomial x to self.
	//
	// If self has enough capacity, Copy will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn Copy(mut *self, &x: *Dense) {
		// self is x, return immediately.
		if self == x {
			return
		}
		*self = self.make(len(*x))
		copy(*self, *x)
	}

	// Sets self to sum x+y.
	//
	// If self has enough capacity, Add will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable nilptr boundary
	fn Add(mut *self, &x: *Dense, &y: *Dense, tol: f64) {
		// Due to disabling nilptr checks, we have to check manually.
		if self == nil {
			panic("Dense.Add: self receiver is nil")
		}
		if x == nil {
			panic("Dense.Add: x is nil")
		}
		if y == nil {
			panic("Dense.Add: y is nil")
		}

		n := ibits::Max(len(*x), len(*y))
		*self = self.make(n)

		mut i := 0
		for i < n {
			mut coef := f64(0)
			if i < len(*x) {
				coef += (*x)[i]
			}
			if i < len(*y) {
				coef += (*y)[i]
			}
			(*self)[i] = coef
			i++
		}
	}

	// Sets self to difference x-y.
	//
	// If self has enough capacity, Sub will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable nilptr boundary
	fn Sub(mut *self, &x: *Dense, &y: *Dense, tol: f64) {
		// Due to disabling nilptr checks, we have to check manually.
		if self == nil {
			panic("Dense.Add: self receiver is nil")
		}
		if x == nil {
			panic("Dense.Add: x is nil")
		}
		if y == nil {
			panic("Dense.Add: y is nil")
		}

		n := ibits::Max(len(*x), len(*y))
		*self = self.make(n)

		mut i := 0
		for i < n {
			mut coef := f64(0)
			if i < len(*x) {
				coef = (*x)[i]
			}
			if i < len(*y) {
				coef -= (*y)[i]
			}
			(*self)[i] = coef
			i++
		}
	}

	// Sets self to scaled coefficients of x by scalar k.
	// For example, if k = 2, (3x^2 - x) becomes (6x^2 - 2x).
	//
	// If self have enough capacity, Scale will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Scale(mut *self, &x: *Dense, k: f64, tol: f64) {
		if len(*x) == 0 {
			// self is an alias for x, return immediately.
			if self == x {
				return
			}
			*self = self.make(0)
			return
		}

		if k == 0 {
			*self = (*self)[:0]
			return
		}

		*self = self.make(len(*x))

		mut i := 0
		for _, coef in *x {
			scaled := coef * k
			if !jn::Tolerance(scaled, 0, tol) {
				(*self)[i] = scaled
				i++
			} else {
				// Preserve the exponent position in Dense.
				(*self)[i] = 0
				i++
			}
		}

		// Remove trailing zero coefficients.
		mut n := len(*self)
		for n > 0 && (*self)[n-1] == 0 {
			n--
		}
		*self = (*self)[:n]
	}

	// Sets self to the first derivative of polynomial x.
	//
	//	If x = ∑ᵢ [ aᵢ * xⁱ ], then self = ∑ᵢ [ (i*aᵢ)·xⁱ⁻¹ ] for i ≥ 1.
	//
	// Constant terms (exp = 0) are omitted.
	//
	// If self have enough capacity, Deriv will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Deriv(mut *self, &x: *Dense) {
		if len(*x) <= 1 {
			*self = (*self)[:0]
			return
		}

		*self = self.make(len(*x) - 1)

		mut i := 1
		for i < len(*x) {
			(*self)[i-1] = f64(i) * (*x)[i]
			i++
		}
	}

	// Sets self to the indefinite integral of polynomial x with constant term C.
	// That is, integrates each term and appends a constant term.
	//
	// If self have enough capacity, Integral will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	// #disable boundary
	#disable boundary
	fn Integral(mut *self, &x: *Dense, C: f64) {
		if len(*x) == 0 {
			if C == 0 {
				*self = (*self)[:0]
				return
			}

			*self = self.make(1)
			(*self)[0] = C
			return
		}

		*self = self.make(len(*x) + 1)
		(*self)[0] = C

		mut i := 0
		for i < len(*x) {
			(*self)[i+1] = (*x)[i] / f64(i+1)
			i++
		}

		// Remove trailing zero coefficients.
		mut n := len(*self)
		for n > 0 && (*self)[n-1] == 0 {
			n--
		}
		*self = (*self)[:n]
	}

	// Evaluates the polynomial at a given x.
	#disable boundary
	fn Eval(*self, x: f64): f64 {
		if len(*self) == 0 {
			return 0
		}

		mut result := (*self)[len(*self)-1]
		mut i := len(*self) - 1

		for i > 0 {
			i--
			result = result*x + (*self)[i]
		}

		return result
	}

	// Sets self to a rescaled polynomial x, so that its leading coefficient is 1.
	// If the polynomial is zero or its leading coefficient is very small, output
	// length is zero.
	//
	// If self have enough capacity, Normalize will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	// #disable boundary
	#disable boundary
	fn Normalize(mut *self, &x: *Dense, tol: f64) {
		if len(*x) == 0 {
			*self = (*self)[:0]
			return
		}

		// Find the actual leading coefficient, ignoring trailing zeros.
		mut n := len(*x)
		for n > 0 && (*x)[n-1] == 0 {
			n--
		}

		if n == 0 {
			*self = (*self)[:0]
			return
		}

		lead := (*x)[n-1]

		// A very small leading coefficient is treated as zero.
		if jn::Tolerance(lead, 0, tol) {
			*self = (*self)[:0]
			return
		}

		// self may alias x, so normalization is performed in-place.
		*self = self.make(n)

		mut i := 0
		for i < n {
			(*self)[i] = (*x)[i] / lead
			i++
		}
	}

	// Sets self to the unique linear polynomial that passes through points (x0, y0) and (x1, y1).
	//
	// The resulting coefficients are stored in ascending order:
	// self[0] = constant term, self[1] = x coefficient.
	//
	// If self have enough capacity, InterpolateLinear will use it to avoid making allocation.
	#disable boundary
	fn InterpolateLinear(mut *self, x0: f64, y0: f64, x1: f64, y1: f64) {
		if x0 == x1 {
			panic("poly: InterpolateLinear: x0 and x1 must be distinct")
		}

		// Compute slope and intercept.
		slope := (y1 - y0) / (x1 - x0)
		intercept := y0 - slope*x0

		*self = self.make(2)
		(*self)[0] = intercept
		(*self)[1] = slope
	}
}