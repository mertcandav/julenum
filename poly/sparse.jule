use jn "julenum"
use "julenum/internal/fourier"
use "julenum/internal/ibits"
use "julenum/internal/imem"
use "std/math"
use "std/slices"

// Represents a single term (monomial) of a polynomial.
// It has a coefficient and an exponent (degree).
//
// Mathematically, a term is expressed as:
//	coef * x^exp, where:
//		- coef ∈ ℝ (coefficient, a real number)
//		- exp ∈ ℕ₀ (non-negative integer exponent)
//
// For example:
//	the term 3x² is represented as Term{Coef: 3, Exp: 2}.
//	the term x is represented as Term{Coef: 1, Exp: 1}.
//	the term 2x is represented as Term{Coef: 2, Exp: 1}.
//	the term 1 is represented as Term{Coef: 1, Exp: 0}
struct Term {
	Coef: f64
	Exp:  int
}

// Represents a polynomial as a slice of Terms.
//
// A polynomial P(x) is a finite sum of terms:
//	P(x) = Σᵢ [ Coefᵢ * x^Expᵢ ]
//
// where each Term is stored as an element of the Terms slice.
//
// Terms are expected to be stored in descending order of exponent (Exp),
// i.e., Terms[0].Exp > Terms[1].Exp > ... > Terms[n-1].Exp,
// which simplifies polynomial operations like addition and multiplication.
// Any corruption in this order is undefined behavior.
//
// Capacity of underlying slices is never changed for values; i.e. that there are
// no 3-operand slice expressions. Any corruption of this rule is undefined behavior.
type Sparse: []Term

impl Sparse {
	// Returns new Sparse buffer enough to store at least n values.
	fn make(mut *self, n: int): Sparse {
		// Reuse self capacity, if there is enough space.
		if n <= cap(*self) {
			return (*self)[:n]
		}
		return make(Sparse, n)
	}

	// Sets self to the given terms.
	//
	// Terms may be in any order. Terms with the same exponent are merged,
	// zero coefficients within tolerance are removed, and the result is
	// sorted by decreasing exponent. Final polynomial will be simplified.
	//
	// If self has enough capacity, Set will reuse it to avoid allocation.
	// If terms is empty, self will be zero-length but keeps its capacity.
	#disable boundary
	fn Set(mut *self, terms: []Term, tol: f64) {
		n := len(terms)
		if n == 0 {
			*self = (*self)[:0]
			return
		}

		// Copy input first so Set never depends on the input slice remaining
		// unchanged while the result is being built.
		*self = self.make(n)
		copy(*self, terms)

		// If terms are unordered, sort them once.
		if !slices::IsSortedFunc(*self, cmp) {
			sortByExp(self)
		}

		// Merge equal exponents and remove zero coefficients.
		//
		// The input is now guaranteed to be non-increasing by exponent.
		mut i := 0
		mut k := 0

		for i < n {
			exp := (*self)[i].Exp
			mut coef := (*self)[i].Coef
			i++

			// Combine all terms having the same exponent.
			for i < n && (*self)[i].Exp == exp {
				coef += (*self)[i].Coef
				i++
			}

			if coef != 0 && !jn::Tolerance(coef, 0, tol) {
				(*self)[k] = Term{
					Coef: coef,
					Exp:  exp,
				}
				k++
			}
		}

		*self = (*self)[:k]
	}

	// Returns the leading coefficient of the polynomial.
	// Panics if polynomial is zero.
	fn LeadingCoef(*self): f64 {
		if len(*self) == 0 {
			panic("poly: LeadingCoef called on zero polynomial")
		}
		return (*self)[0].Coef
	}

	// Reports whether polynomial is zero within tolerance.
	fn Zero(*self, tol: f64): bool {
		for _, term in *self {
			if !jn::Tolerance(term.Coef, 0, tol) {
				return false
			}
		}
		return true
	}

	// Returns the degree of the polynomial (highest exponent).
	// Returns -1 for the zero polynomial.
	fn Degree(*self): int {
		if len(*self) == 0 {
			return -1
		}
		return (*self)[0].Exp
	}

	// Sets self to negated coefficients of the polynomial x.
	// For example, (3x^2 - 4x + 1) becomes (-3x^2 + 4x - 1).
	//
	// If self have enough capacity, Negate will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Negate(mut *self, &x: *Sparse) {
		*self = self.make(len(*x))
		for i in *x {
			(*self)[i] = Term{Coef: -(*x)[i].Coef, Exp: (*x)[i].Exp}
		}
	}

	// Copies polynomial x to self.
	//
	// If self have enough capacity, Negate will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn Copy(mut *self, &x: *Sparse) {
		// self is an x for self, return immediately.
		if self == x {
			return
		}
		*self = self.make(len(*x))
		copy(*self, *x)
	}

	// Sets self to simplified form of the polynomial p.
	// IT merges like terms and removes zero coefficients with tolerance.
	//
	// Result is sorted by decreasing exponent.
	// If the Sparse manually modified, this function may help to follow internal
	// polynomial representation rules as described in Sparse type.
	//
	// If self have enough capacity, Simplify will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn Simplify(mut *self, &p: *Sparse, tol: f64) {
		self.Set([]Term(*p), tol)
	}

	// Sets self to sum x+y.
	//
	// If self have enough capacity, Add will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Add(mut *self, &x: *Sparse, &y: *Sparse, tol: f64) {
		// If y is empty, just copy x.
		if len(*y) == 0 {
			// self is an x for self, return immediately.
			if self == x {
				return
			}
			*self = self.make(len(*x))
			copy(*self, *x)
			return
		}
		// If x is empty, just copy y.
		if len(*x) == 0 {
			// self is an alias for y, return immediately.
			if self == y {
				return
			}
			*self = self.make(len(*y))
			copy(*self, *y)
			return
		}

		// Allocate result Sparse.
		let mut r: Sparse
		if self == x || self == y || alias(self, x) || alias(self, y) {
			// self is an alias for x or y - cannot reuse.
			// We have to allocate new Sparse to compute properly.
			r = make(Sparse, len(*x)+len(*y))
		} else {
			r = self.make(len(*x) + len(*y))
		}
		// compute x+y

		mut i, mut j, mut k := 0, 0, 0
		for i < len(*x) && j < len(*y) {
			xi, yj := (*x)[i], (*y)[j]
			if xi.Exp == yj.Exp {
				sumCoef := xi.Coef + yj.Coef
				if !jn::Tolerance(sumCoef, 0, tol) {
					r[k] = Term{Coef: sumCoef, Exp: xi.Exp}
					k++
				}
				i++
				j++
			} else if xi.Exp > yj.Exp {
				r[k] = xi
				k++
				i++
			} else {
				r[k] = yj
				k++
				j++
			}
		}
		// Append remaining terms.
		for i < len(*x); i, k = i+1, k+1 {
			r[k] = (*x)[i]
		}
		for j < len(*y); j, k = j+1, k+1 {
			r[k] = (*y)[j]
		}

		// Trim to actual length.
		// Zero coefficients ignored, so final length may be different.
		*self = r[:k]
	}

	// Sets self to difference x-y.
	//
	// If self have enough capacity, Sub will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Sub(mut *self, &x: *Sparse, &y: *Sparse, tol: f64) {
		// If y is empty, just copy x.
		if len(*y) == 0 {
			// self is an x for self, return immediately.
			if self == x {
				return
			}
			*self = self.make(len(*x))
			copy(*self, *x)
			return
		}
		// If x is empty, just copy y.
		if len(*x) == 0 {
			*self = self.make(len(*y))
			for (i, mut p) in *y {
				p.Coef = -p.Coef
				(*self)[i] = p
			}
			return
		}

		// Allocate result Sparse.
		let mut r: Sparse
		if self == x || self == y || alias(self, x) || alias(self, y) {
			// self is an alias for x or y - cannot reuse.
			// We have to allocate new Sparse to compute properly.
			r = make(Sparse, len(*x)+len(*y))
		} else {
			r = self.make(len(*x) + len(*y))
		}
		// compute x-y

		mut i, mut j, mut k := 0, 0, 0
		for i < len(*x) && j < len(*y) {
			xi, mut yj := (*x)[i], (*y)[j]
			if xi.Exp == yj.Exp {
				diffCoef := xi.Coef - yj.Coef
				if !jn::Tolerance(diffCoef, 0, tol) {
					r[k] = Term{Coef: diffCoef, Exp: xi.Exp}
					k++
				}
				i++
				j++
			} else if xi.Exp > yj.Exp {
				r[k] = xi
				k++
				i++
			} else {
				yj.Coef = -yj.Coef
				r[k] = yj
				k++
				j++
			}
		}
		// Append remaining terms.
		for i < len(*x); i, k = i+1, k+1 {
			r[k] = (*x)[i]
		}
		for j < len(*y); j, k = j+1, k+1 {
			r[k] = Term{Coef: -(*y)[j].Coef, Exp: (*y)[j].Exp}
		}

		// Trim to actual length.
		// Zero coefficients ignored, so final length may be different.
		*self = r[:k]
	}

	// Sets self to scaled coefficients of x by scalar k.
	// For example, if k = 2, (3x^2 - x) becomes (6x^2 - 2x).
	//
	// If self have enough capacity, Scale will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Scale(mut *self, &x: *Sparse, k: f64, tol: f64) {
		if len(*x) == 0 || k == 1 {
			// self is an alias for x, return immediately.
			if self == x {
				return
			}
			*self = self.make(len(*x))
			copy(*self, *x)
			return
		}
		if k == 0 {
			*self = (*self)[:0]
			return
		}
		*self = self.make(len(*x))
		mut i := 0
		for _, term in *x {
			coef := term.Coef * k
			if !jn::Tolerance(coef, 0, tol) {
				(*self)[i] = Term{
					Coef: coef,
					Exp:  term.Exp,
				}
				i++
			}
		}

		// Trim to actual length.
		// Zero coefficients ignored, so final length may be different.
		*self = (*self)[:i]
	}

	// Sets self to product x*y.
	//
	// It is equals to MulTol(x, y, tol), but determines tolerance dynamically.
	// Dynamic tolerance value might not be suitable for some cases.
	// Use MulTol with custom tolerance when needed, especially for precise
	// and small coefficients like 1e-14. However, small coefficients might be removed
	// due to rounding errors during computation with custom tolerance.
	//
	// For minimum rounding-errors, use MulNaive to force native algorithms.
	// Naive algorithm is slower than FFT, but it is more accurate.
	//
	// If self have enough capacity, Mul will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Mul(mut *self, &x: *Sparse, &y: *Sparse) {
		// Early return: x or y is zero.
		if len(*x) == 0 || len(*y) == 0 {
			*self = (*self)[:0]
			return
		}
		kind, tolSize := selectMulAlgorithm(x, y)
		match kind {
		| 0:
			basicMul(self, x, y)
		| 1:
			denseMul(self, x, y)
		|:
			tol := dynamicTolerance(x, y, tolSize)
			size := fftSize(x, y)
			fftMul(self, x, y, size, tol)
		}
	}

	// Sets self to product x*y.
	//
	// Like Mul but forces to naive algorithm and never uses FFT.
	// Provides more accurate results, but slower for large polynomials.
	//
	// If self have enough capacity, MulNaive will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn MulNaive(mut *self, &x: *Sparse, &y: *Sparse) {
		// Early return: x or y is zero.
		if len(*x) == 0 || len(*y) == 0 {
			*self = (*self)[:0]
			return
		}
		basicMul(self, x, y)
	}

	// Sets self to product x*y.
	//
	// Unlike Mul, this function takes custom tolerance and it uses for FFT.
	// If FFT algorithm will not be used, tolerance will not be used.
	//
	// Algorithm will select naive algorithm of FFT to compute,
	// which one is efficient for the case.
	//
	// If self have enough capacity, MulTol will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn MulTol(mut *self, &x: *Sparse, &y: *Sparse, tol: f64) {
		// Early return: x or y is zero.
		if len(*x) == 0 || len(*y) == 0 {
			*self = (*self)[:0]
			return
		}
		kind, _ := selectMulAlgorithm(x, y)
		match kind {
		| 0:
			basicMul(self, x, y)
		| 1:
			denseMul(self, x, y)
		|:
			size := fftSize(x, y)
			fftMul(self, x, y, size, tol)
		}
	}

	// Sets self to product x*y.
	//
	// Like MulTol but forces to FFT and never uses naive algorithm.
	// Provides faster computations for large polynomaisl, but less accurate.
	//
	// If self have enough capacity, MulFFT will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn MulFFT(mut *self, &x: *Sparse, &y: *Sparse, tol: f64) {
		// Early return: x or y is zero.
		if len(*x) == 0 || len(*y) == 0 {
			*self = (*self)[:0]
			return
		}

		size := fftSize(x, y)
		fftMul(self, x, y, size, tol)
	}

	// Sets self to quotient x/y, sets rem to remainder x/y if it is not nil.
	// Panics for divide by zero.
	//
	// It uses naive division for small inputs, FFT division for larger inputs.
	// When FFT division used, accuracy decreased due to floating-point rounding.
	// Especiall remainder is less accurate compared to naive division.
	//
	// For minimum rounding-errors, use DivModNaive to force native division.
	// Naive algorithm is slower than FFT, but it is more accurate.
	//
	// If self and rem have enough capacity, DivMod will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn DivMod(mut *self, &x: *Sparse, &y: *Sparse, mut &rem: *Sparse) {
		if len(*y) == 0 {
			panic("poly: division by zero")
		}

		kind, _ := selectMulAlgorithm(x, y)
		if rem != nil {
			match kind {
			| 0 | 1:
				basicDivMod(self, x, y, rem)
			|:
				fftDivMod(self, x, y, rem)
			}
		} else {
			let mut _rem: Sparse
			match kind {
			| 0 | 1:
				basicDivMod(self, x, y, &_rem)
			|:
				fftDivMod(self, x, y, &_rem)
			}
		}
	}

	// Sets self to quotient x/y, sets rem to remainder x/y if it is not nil.
	// Panics for divide by zero.
	//
	// Like DivMod but forces to naive algorithm and never uses FFT.
	// Provides more accurate results, but slower for large polynomials.
	//
	// If self and rem have enough capacity, DivMod will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn DivModNaive(mut *self, &x: *Sparse, &y: *Sparse, mut &rem: *Sparse) {
		if len(*y) == 0 {
			panic("poly: division by zero")
		}

		if rem != nil {
			basicDivMod(self, x, y, rem)
		} else {
			let mut _rem: Sparse
			basicDivMod(self, x, y, &_rem)
		}
	}

	// Sets self to quotient x/y, sets rem to remainder x/y if it is not nil.
	// Panics for divide by zero.
	//
	// Like DivMod but forces FFT division and never uses naive division.
	// Provides faster computations for large polynomials, but may introduce
	// more floating-point rounding errors, especially in the remainder.
	//
	// If self and rem have enough capacity, DivModFFT will use it to avoid
	// making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn DivModFFT(mut *self, &x: *Sparse, &y: *Sparse, mut &rem: *Sparse) {
		if len(*y) == 0 {
			panic("poly: division by zero")
		}
		if rem != nil {
			fftDivMod(self, x, y, rem)
		} else {
			let mut _rem: Sparse
			fftDivMod(self, x, y, &_rem)
		}
	}

	// Sets self to the first derivative of polynomial x.
	//
	//	If x = ∑ᵢ [ aᵢ * xⁱ ], then self = ∑ᵢ [ (i*aᵢ)·xⁱ⁻¹ ] for i ≥ 1.
	//
	// Constant terms (exp = 0) are omitted.
	//
	// If self have enough capacity, Deriv will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Deriv(mut *self, &x: *Sparse) {
		*self = self.make(len(*x))

		mut k := 0
		for _, term in *x {
			if term.Exp != 0 {
				(*self)[k] = Term{
					Coef: term.Coef * f64(term.Exp),
					Exp:  term.Exp - 1,
				}
				k++
			}
		}

		// Trim to actual length.
		// Zero coefficients ignored, so final length may be different.
		*self = (*self)[:k]
	}

	// Sets self to the indefinite integral of polynomial x with constant term C.
	// That is, integrates each term and appends a constant term.
	//
	// If self have enough capacity, Integral will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Integral(mut *self, &x: *Sparse, C: f64) {
		n := len(*x)
		*self = self.make(n + 1)

		mut i := 0
		for i < n; i++ {
			exp := (*x)[i].Exp + 1
			(*self)[i].Exp = exp
			(*self)[i].Coef = (*x)[i].Coef / f64(exp)
		}

		// Constant term
		if C != 0 {
			(*self)[i] = Term{Coef: C, Exp: 0}
		} else {
			*self = (*self)[:i] // remove trailing zero if C=0
		}
	}

	// Evaluates the polynomial at a given x.
	#disable boundary
	fn Eval(*self, x: f64): f64 {
		match len(*self) {
		| 0:
			return 0
		| 1:
			t := (*self)[0]
			if t.Exp == 0 {
				return t.Coef
			}
			return t.Coef * math::Pow(x, f64(t.Exp))
		}

		// For general case: cache powers of x on the fly.
		let mut result: f64
		mut powCache := map[int]f64{}
		for _, term in *self {
			if term.Exp == 0 {
				result += term.Coef
				continue
			}
			mut px, ok := powCache[term.Exp]
			if !ok {
				px = math::Pow(x, f64(term.Exp))
				powCache[term.Exp] = px
			}
			result += term.Coef * px
		}
		return result
	}

	// Sets self to the greatest common divisor of two polynomials x and y.
	// Leading coefficient is normalized to 1 (if not zero).
	//
	// If self have enough capacity, GCD will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn GCD(mut *self, &x: *Sparse, &y: *Sparse, tol: f64) {
		let mut X: Sparse
		let mut Y: Sparse
		let mut R: Sparse
		let mut Q: Sparse
		X.Copy(x)
		Y.Copy(y)

		for !Y.Zero(tol) && !jn::Tolerance(Y.LeadingCoef(), 0, tol) {
			Q.DivMod(&X, &Y, &R)
			X.Copy(&Y)
			Y.Copy(&R)
		}

		// Normalize leading coefficient to 1
		if !X.Zero(tol) {
			lc := X.LeadingCoef()
			if jn::Tolerance(lc, 0, tol) {
				*self = (*self)[:0]
				return
			}

			self.Scale(&X, 1/lc, tol)
		} else {
			*self = (*self)[:0]
		}
	}

	// Sets self to the least common multiple of two polynomials x and y.
	// Leading coefficient is normalized to 1 (if not zero).
	//
	// If self have enough capacity, LCM will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	fn LCM(mut *self, &x: *Sparse, &y: *Sparse, tol: f64) {
		if x.Zero(tol) || y.Zero(tol) {
			*self = (*self)[:0]
			return
		}

		let mut product: Sparse
		product.MulNaive(x, y)
		let mut gcd: Sparse
		gcd.GCD(x, y, tol)
		self.DivMod(&product, &gcd, nil)

		// Normalize leading coefficient to 1
		if !self.Zero(tol) {
			lc := self.LeadingCoef()
			if !jn::Tolerance(lc, 0, tol) {
				self.Scale(self, 1/lc, tol)
			}
		} else {
			*self = (*self)[:0]
		}
	}

	// Sets self to product x^n.
	// Condition n >= 0 must be true.
	//
	// If self have enough capacity, Pow will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Pow(mut *self, &x: *Sparse, mut n: int) {
		if n < 0 {
			panic("poly: negative exponent not supported")
		}
		if n == 0 {
			// p^0 = 1
			*self = self.make(1)
			(*self)[0].Coef = 1
			(*self)[0].Exp = 0
			return
		}
		if n == 1 {
			// self is an alias for x, return immediately.
			if self == x {
				return
			}
			*self = self.make(len(*x))
			copy(*self, *x)
			return
		}

		let mut base: Sparse
		base = make(Sparse, len(*x))
		copy(base, *x)

		// *self = 1
		*self = self.make(1)
		(*self)[0].Coef = 1
		(*self)[0].Exp = 0

		for n > 0; n >>= 1 {
			if n&1 == 1 {
				self.MulNaive(self, &base)
			}
			base.MulNaive(&base, &base)
		}
	}

	// Sets self to rescaled polynomial x, so that its leading coefficient is 1.
	// If the polynomial is zero or leading coefficient is very small, output length is zero.
	//
	// If self have enough capacity, Normalize will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn Normalize(mut *self, &x: *Sparse, tol: f64) {
		if len(*x) == 0 {
			*self = (*self)[:0]
			return // zero polynomial, do nothing
		}

		lc := (*x)[0].Coef
		if jn::Tolerance(lc, 0, tol) {
			*self = (*self)[:0]
			return // avoid division by near-zero
		}

		*self = self.make(len(*x))
		for i in *x {
			(*self)[i].Coef = (*x)[i].Coef / lc
			(*self)[i].Exp = (*x)[i].Exp
		}
	}

	// Sets self to the unique linear polynomial that passes through points (x0, y0) and (x1, y1).
	//
	// If self have enough capacity, InterpolateLinear will use it to avoid making allocation.
	#disable boundary
	fn InterpolateLinear(mut *self, x0: f64, y0: f64, x1: f64, y1: f64) {
		if x0 == x1 {
			panic("poly: InterpolateLinear: x0 and x1 must be distinct")
		}
		// Compute slope and intercept.
		slope := (y1 - y0) / (x1 - x0) // m
		intercept := y0 - slope*x0     // b
		*self = self.make(2)
		(*self)[0] = Term{Coef: slope, Exp: 1}     // m * x
		(*self)[1] = Term{Coef: intercept, Exp: 0} // b
	}

	// Sets self to the unique degree-(n-1) polynomial that passes through the
	// given points using the Lagrange interpolation formula.
	// Panics if input lengths differ or have duplicate x values.
	//
	// If self have enough capacity, InterpolateLagrance will use it to avoid making allocation.
	// If length is zero, self will be zero-length. But keeps internal allocation.
	#disable boundary
	fn InterpolateLagrange(mut *self, xs: []f64, ys: []f64, tol: f64) {
		if len(xs) != len(ys) {
			panic("poly: InterpolateLagrange: xs and ys must be the same length")
		}
		n := len(xs)
		if n == 0 {
			*self = (*self)[:0]
			return
		}

		mut i := 0
		for i < n; i++ {
			// Start with constant polynomial 1
			mut basis := Sparse([{1, 0}])
			mut denom := 1.0

			mut j := 0
			for j < n; j++ {
				if i == j {
					continue
				}
				if math::Abs(xs[i]-xs[j]) < tol {
					panic("poly: InterpolateLagrange: duplicate x values")
				}
				// Multiply by (x - xj)
				mut tmp := Sparse([{1, 1}, {-xs[j], 0}])
				basis.MulNaive(&basis, &tmp)

				// Denominator: (xi - xj)
				denom *= xs[i] - xs[j]
			}

			basis.Scale(&basis, ys[i]/denom, tol) // Scale basis polynomial by yi / denom
			self.Add(self, &basis, tol)
		}
	}
}

// Algorithm codes:
//	0: basicMul
//	1: denseMul
//	2: fftMul
#disable boundary
fn selectMulAlgorithm(&x: *Sparse, &y: *Sparse): (int, int) {
	nx := len(*x)
	ny := len(*y)

	if nx == 0 || ny == 0 {
		return 0, 0
	}

	// Very small inputs are faster with direct sparse multiplication.
	work := nx * ny
	if work <= 64 {
		return 0, 0
	}

	degX := (*x)[0].Exp
	degY := (*y)[0].Exp

	// Degree span of the result.
	degree := degX + degY + 1

	// Estimate how densely populated the coefficient space is.
	densityX := f64(nx) / f64(degX+1)
	densityY := f64(ny) / f64(degY+1)

	density := math::Min(densityX, densityY)

	// Sparse polynomials should never be sent to FFT merely because
	// their term count is large.
	if density < 0.05 {
		return 0, 0
	}

	// Dense convolution is preferable to FFT for medium-sized inputs.
	if degree <= 4096 && work <= 1_000_000 {
		return 1, degree
	}

	// FFT only when the coefficient domain is sufficiently dense.
	if density >= 0.20 {
		return 2, degree
	}

	// Moderately sparse: direct multiplication is safer and often faster.
	return 0, 0
}

#disable boundary
fn denseMul(mut &z: *Sparse, &x: *Sparse, &y: *Sparse) {
	if len(*x) == 0 || len(*y) == 0 {
		*z = (*z)[:0]
		return
	}

	degX := (*x)[0].Exp
	degY := (*y)[0].Exp
	size := degX + degY + 1

	mut coeffs := make([]f64, size)

	for _, a in *x {
		if a.Coef == 0 {
			continue
		}

		for _, b in *y {
			if b.Coef == 0 {
				continue
			}

			coeffs[a.Exp+b.Exp] += a.Coef * b.Coef
		}
	}

	// At most nx + ny - 1 non-zero terms can be produced
	// for dense input, but zero coefficients may be present.
	*z = z.make(size)

	mut k := 0

	// Polynomial terms are stored in descending exponent order.
	mut exp := size
	for exp > 0 {
		exp--

		coef := coeffs[exp]
		if coef != 0 {
			(*z)[k] = Term{
				Coef: coef,
				Exp:  exp,
			}
			k++
		}
	}

	*z = (*z)[:k]
}

#disable boundary
fn dynamicTolerance(&x: *Sparse, &y: *Sparse, size: int): f64 {
	const (
		machineEpsilon = 2.22e-16
		safetyFactor   = 10000000.0 // Increase to be stricter, for large sizes.
		smallThreshold = 200
	)

	if size < smallThreshold {
		mut maxCoef := 0.0
		for _, term in *x {
			absCoef := math::Abs(term.Coef)
			if absCoef > maxCoef {
				maxCoef = absCoef
			}
		}
		for _, term in *y {
			absCoef := math::Abs(term.Coef)
			if absCoef > maxCoef {
				maxCoef = absCoef
			}
		}

		if maxCoef == 0 {
			return 0
		}

		basicTol := machineEpsilon * f64(size) * maxCoef
		relativeTol := 1e-14 * maxCoef
		absoluteTol := 1e-16
		return math::Max(basicTol, math::Max(relativeTol, absoluteTol))
	} else {
		return machineEpsilon * f64(size) * math::Log2(f64(size)) * safetyFactor
	}
}

// z = x*y
#disable boundary
fn basicMul(mut &z: *Sparse, &x: *Sparse, &y: *Sparse) {
	if len(*x) == 0 || len(*y) == 0 {
		*z = (*z)[:0]
		return
	}

	// Keep the larger polynomial in the outer loop.
	// This does not change complexity, but reduces loop overhead
	// when one polynomial is much smaller than the other.
	let mut outer: *Sparse
	let mut inner: *Sparse
	if len(*x) >= len(*y) {
		outer = unsafe { *&x }
		inner = unsafe { *&y }
	} else {
		outer = unsafe { *&y }
		inner = unsafe { *&x }
	}

	n := unsafe { len(*outer) * len(*inner) }

	// The number of distinct exponents can be as high as nx*ny
	// for sparse polynomials with irregular exponents.
	mut temp := make(map[int]f64, n)

	for _, a in unsafe { *outer } {
		if a.Coef == 0 {
			continue
		}

		acoef := a.Coef
		aexp := a.Exp

		for _, b in unsafe { *inner } {
			if b.Coef == 0 {
				continue
			}

			exp := aexp + b.Exp
			temp[exp] += acoef * b.Coef
		}
	}

	if len(temp) == 0 {
		*z = (*z)[:0]
		return
	}

	*z = z.make(len(temp))

	mut k := 0
	for exp, coef in temp {
		if coef != 0 {
			(*z)[k] = Term{
				Coef: coef,
				Exp:  exp,
			}
			k++
		}
	}

	*z = (*z)[:k]

	if k > 1 {
		sortByExp(z)
	}
}

// quot = quotient x/y
// rem = remainder x/y
#disable boundary
fn basicDivMod(mut &quot: *Sparse, &x: *Sparse, &y: *Sparse, mut &rem: *Sparse) {
	if len(*x) == 0 {
		*quot = (*quot)[:0]
		if rem != nil {
			*rem = rem.make(len(*y))
			copy(*rem, *y)
		}
		return
	}

	degDiv := (*y)[0].Exp
	coefDiv := (*y)[0].Coef
	if coefDiv == 0 {
		panic("poly: leading coefficient of divisor is zero")
	}

	degX := (*x)[0].Exp
	degY := (*y)[0].Exp

	if rem != x {
		*rem = rem.make(len(*x))
		copy(*rem, *x)
	}

	if degX < degY {
		*quot = (*quot)[:0]
		return
	}

	mut k := degX - degY + 1

	let mut zquot: Sparse

	if quot == y || alias(quot, y) {
		// self is an alias y - cannot reuse.
		// We have to allocate new Sparse to compute properly.
		zquot = make(Sparse, k)
	} else {
		zquot = quot.make(k)
	}

	k = 0
	mut subtrahend := make(Sparse, len(*y))
	for len(*rem) > 0 && (*rem)[0].Exp >= degDiv; k++ {
		leadRem := (*rem)[0]
		expDiff := leadRem.Exp - degDiv
		coefQuot := leadRem.Coef / coefDiv
		zquot[k] = Term{Coef: coefQuot, Exp: expDiff}
		for i, dterm in *y {
			subtrahend[i] = Term{
				Coef: dterm.Coef * coefQuot,
				Exp:  dterm.Exp + expDiff,
			}
		}
		rem.Sub(rem, &subtrahend, 0)
	}

	// Trim to actual length.
	// Zero coefficients ignored, so final length may be different.
	*quot = zquot[:k]
}

// p(x) -> x^degree * p(1/x)
#disable boundary
fn reverse(mut &rev: *Sparse, &p: *Sparse, degree: int) {
	*rev = rev.make(len(*p))
	for i, term in *p {
		(*rev)[i] = Term{Coef: term.Coef, Exp: degree - term.Exp}
	}
	sortByExp(rev)
}

// (mod x^k)
#disable boundary
fn truncate(mut &x: *Sparse, k: int) {
	mut i := 0
	for _, term in *x {
		if term.Exp < k {
			(*x)[i] = term
			i++
		}
	}
	*x = (*x)[:i]
}

// d(x), c(x)d(x) = 1 (mod x^k)
fn inverse(mut &inv: *Sparse, &c: *Sparse, k: int) {
	if k == 0 {
		*inv = (*inv)[:0]
		return
	}
	if k == 1 {
		let mut c0: f64
		for _, term in *c {
			if term.Exp == 0 {
				c0 = term.Coef
				break
			}
		}
		if math::Abs(c0) == 0 {
			panic("poly: constant zero term is illegal for inverse")
		}
		*inv = make(Sparse, 1)
		(*inv)[0] = Term{Coef: 1.0 / c0, Exp: 0}
		return
	}

	k_half := (k + 1) / 2
	let mut d_prev: Sparse
	inverse(&d_prev, c, k_half)

	let mut temp: Sparse
	temp.Mul(c, &d_prev)
	truncate(&temp, k)

	two := Sparse([{Coef: 2, Exp: 0}])
	temp.Sub(&two, &temp, 0)

	inv.Mul(&d_prev, &temp)
	truncate(inv, k)
}

fn fftDivMod(mut &q: *Sparse, &a: *Sparse, &b: *Sparse, mut &r: *Sparse) {
	if len(*b) == 0 || ((*b)[0].Exp == 0 && math::Abs((*b)[0].Coef) == 0) {
		panic("poly: division by zero")
	}

	if len(*a) == 0 {
		*q = (*q)[:0]
		if r != nil {
			*r = r.make(len(*b))
			copy(*r, *b)
		}
		return
	}

	degA := (*a)[0].Exp
	degB := (*b)[0].Exp

	if degA < degB {
		*q = (*q)[:0]
		if r != nil {
			*r = r.make(len(*a))
			copy(*r, *a)
		}
		return
	}

	k := degA - degB + 1

	let mut aRev: Sparse
	reverse(&aRev, a, degA)
	let mut bRev: Sparse
	reverse(&bRev, b, degB)

	// (mod x^k)
	let mut invB: Sparse
	inverse(&invB, &bRev, k)

	// 3. qRev = aRev * invB mod x^k
	let mut qRev: Sparse
	basicMul(&qRev, &aRev, &invB)

	truncate(&qRev, k)

	// q = reverse(qRev)
	reverse(q, &qRev, k-1)

	// qb = q * b
	let mut qb: Sparse
	basicMul(&qb, q, b)

	// r = a - qb
	r.Sub(a, &qb, 0)

	truncate(r, degB)
}

#disable nilptr boundary
fn coeffsToSparse(mut &z: *Sparse, coeffs: []cmplx128, tol: f64) {
	*z = z.make(len(coeffs))
	mut k := 0

	mut exp := len(coeffs) - 1
	for exp >= 0; exp-- {
		coef := real(coeffs[exp])
		if !jn::Tolerance(coef, 0, tol) {
			(*z)[k] = Term{Coef: coef, Exp: exp}
			k++
		}
	}

	// Trim to actual length.
	// Zero coefficients ignored, so final length may be different.
	*z = (*z)[:k]

	// No need for: sortByExp(z)
}

#disable nilptr boundary
fn fftSize(&x: *Sparse, &y: *Sparse): int {
	mut maxExpX, mut maxExpY := 0, 0
	if len(*x) > 0 {
		maxExpX = (*x)[0].Exp
	}
	if len(*y) > 0 {
		maxExpY = (*y)[0].Exp
	}
	maxExpX = ibits::Max(maxExpX, len(*x))
	maxExpY = ibits::Max(maxExpY, len(*y))
	return ibits::NextPowerOfTwo(maxExpX + maxExpY + 1)
}

#disable nilptr boundary
fn sparsePairToCoeffs(mut &z: *[]cmplx128, &x: *Sparse, &y: *Sparse) {
	for _, term in *x {
		(*z)[term.Exp] += cmplx(term.Coef, 0)
	}
	for _, term in *y {
		(*z)[term.Exp] += cmplx(0, term.Coef)
	}
}

#disable nilptr boundary
fn packedMultiply(mut &z: *[]cmplx128) {
	n := len(*z)
	half := n >> 1

	// DC component.
	{
		// For the DC component both recovered values are real.
		v := (*z)[0]
		(*z)[0] = cmplx(real(v)*imag(v), 0)
	}

	// Positive frequencies.
	mut k := 1
	for k < half; k++ {
		j := n - k

		zk := (*z)[k]
		zj := (*z)[j]

		zkr := real(zk)
		zki := imag(zk)
		zjr := real(zj)
		zji := imag(zj)

		// Recover A[k].
		//
		// A = (Z[k] + conj(Z[n-k])) / 2
		ar := 0.5 * (zkr + zjr)
		ai := 0.5 * (zki - zji)

		// Recover B[k].
		//
		// B = (Z[k] - conj(Z[n-k])) / (2i)
		br := 0.5 * (zki + zji)
		bi := -0.5 * (zkr - zjr)

		// A * B.
		cr := ar*br - ai*bi
		ci := ar*bi + ai*br

		(*z)[k] = cmplx(cr, ci)
		(*z)[j] = cmplx(cr, -ci)
	}

	// Nyquist component.
	{
		v := (*z)[half]
		(*z)[half] = cmplx(real(v)*imag(v), 0)
	}
}

#disable boundary
fn fftMul(mut &z: *Sparse, &x: *Sparse, &y: *Sparse, size: int, tol: f64) {
	mut spectrum := make([]cmplx128, size)
	sparsePairToCoeffs(&spectrum, x, y)
	fourier::CoefficientsRadix2(spectrum, false)
	packedMultiply(&spectrum)
	fourier::CoefficientsRadix2(spectrum, true)
	coeffsToSparse(z, spectrum, tol)
}

// Sort terms of the polynomial p by decreasing exponent.
fn sortByExp(mut &p: *Sparse) {
	slices::SortFunc([]Term(*p), cmp)
}

fn cmp(i: Term, j: Term): int {
	match {
	| i.Exp == j.Exp:
		return 0
	| i.Exp > j.Exp:
		return -1
	|:
		return +1
	}
}

// Reports whether x and y share the same base array.
//
// Note: alias assumes that the capacity of underlying arrays
// is never changed for values; i.e. that there are
// no 3-operand slice expressions in this code (or worse,
// reflect-based operations to the same effect).
fn alias(&x: *Sparse, &y: *Sparse): bool {
	return imem::Alias([]Term(*x), []Term(*y))
}