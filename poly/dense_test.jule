use "std/slices"
use "std/testing"

struct denseIOTest {
	input: Dense
	want:  Dense
}

let testsDenseSimplify: []denseIOTest = [
	{
		input: [],
		want:  [],
	},
	{
		// 3x^2 + 4x^2 - x + x + 0 = 7x^2
		input: [0, 0, 7],
		want:  [0, 0, 7],
	},
	{
		// 1 - 1 = 0
		input: [0],
		want:  [],
	},
	{
		// 2x^3 + 5x^3 - x = 7x^3 - x
		input: [0, -1, 0, 7],
		want:  [0, -1, 0, 7],
	},
	{
		// 3x^4 + 2x^2 - 3x^4 - 2x^2 = 0
		input: [0, 0, 0, 0, 0],
		want:  [],
	},
	{
		// 2x + 3x^7 + 4x^3 + 5x^5
		input: [0, 2, 0, 4, 0, 5, 0, 3],
		want:  [0, 2, 0, 4, 0, 5, 0, 3],
	},
	{
		// 5x^5 - 2x^3 + 7x + 1
		input: [1, 7, 0, -2, 0, 5],
		want:  [1, 7, 0, -2, 0, 5],
	},
	{
		// x^7 + 2x^3 + 4x^7 - 2x^3 + 8x^5 + 1 - 3x^5 + 6x^3
		// = 5x^7 + 5x^5 + 6x^3 + 1
		input: [1, 0, 0, 6, 0, 5, 0, 5],
		want:  [1, 0, 0, 6, 0, 5, 0, 5],
	},
	{
		// -4x^6 + 7x^6 - 3x^6 - 2x^2 + 5x^2
		// = 3x^2
		input: [0, 0, 3, 0, 0, 0, 0],
		want:  [0, 0, 3],
	},
	{
		// 2x^4 + 3x^2 + 5x^4 = 7x^4 + 3x^2
		input: [0, 0, 3, 0, 7],
		want:  [0, 0, 3, 0, 7],
	},
]

#test
fn testDenseSimplify(t: &testing::T) {
	for _, test in testsDenseSimplify {
		let mut r: Dense
		r.Simplify(&test.input, 0)
		if !slices::Equal(r, test.want) {
			t.Errorf("Simplify({}, 0) = {}, expected {}", test.input, r, test.want)
		}
	}
}

let testsDenseNegate: []denseIOTest = [
	{
		input: [3, -4, 1],
		want:  [-3, 4, -1],
	},
	{
		input: [],
		want:  [],
	},
	{
		input: [0, 0, -1, 0, 0, 1],
		want:  [0, 0, 1, 0, 0, -1],
	},
]

#test
fn testDenseNegate(t: &testing::T) {
	for _, test in testsDenseNegate {
		let mut r: Dense
		r.Negate(&test.input)
		if !slices::Equal(r, test.want) {
			t.Errorf("Negate({}) = {}, expected {}", test.input, r, test.want)
		}
	}
}

struct testDenseCS {
	x:    Dense
	y:    Dense
	want: Dense
}

let testsDenseAdd: []testDenseCS = [
	{
		x:    [],
		y:    [],
		want: [],
	},
	{
		x:    [2, 0, 0, 1],
		y:    [],
		want: [2, 0, 0, 1],
	},
	{
		x:    [],
		y:    [2, 0, 0, 1],
		want: [2, 0, 0, 1],
	},
	{
		x:    [1, 2, 3],
		y:    [4, 5, 6],
		want: [5, 7, 9],
	},
	{
		x:    [3, -4, 1],
		y:    [-3, 4, -1],
		want: [0, 0, 0],
	},
	{
		x:    [1, 2, 3],
		y:    [4, 5],
		want: [5, 7, 3],
	},
	{
		x:    [4, 5],
		y:    [1, 2, 3],
		want: [5, 7, 3],
	},
	{
		x:    [3, 0, -2, 0, 5],
		y:    [1, 4, 2],
		want: [4, 4, 0, 0, 5],
	},
	{
		x:    [1, 2, 0, 0, 3],
		y:    [-1, -2],
		want: [0, 0, 0, 0, 3],
	},
	{
		x:    [1e-6, 2e-6, 3e-6],
		y:    [1e-6, -2e-6, 4e-6],
		want: [2e-6, 0, 7e-6],
	},
]

#test
fn testDenseAdd(t: &testing::T) {
	for _, test in testsDenseAdd {
		let mut r: Dense
		r.Add(&test.x, &test.y, 0)

		if !slices::Equal(r, test.want) {
			t.Errorf("Add({}, {}, 0) = {}, expected {}", test.x, test.y, r, test.want)
		}
	}
}