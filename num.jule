use "std/math"

// Returns true when a and b have an absolute difference not greater than tol.
fn EqualWithinAbs(a: f64, b: f64, tol: f64): bool {
	return a == b || math::Abs(a-b) <= tol
}

// The smallest normal number.
// For 64 bit IEEE-754 floats this is 2^{-1022}.
const minNormalF64 = 0x1p-1022

// Returns true when the difference between a and b
// is not greater than tol times the greater absolute value of a and b,
//
//	abs(a-b) <= tol * max(abs(a), abs(b)).
fn EqualWithinRel(a: f64, b: f64, tol: f64): bool {
	if a == b {
		return true
	}
	delta := math::Abs(a - b)
	if delta <= minNormalF64 {
		return delta <= tol*minNormalF64
	}
	// We depend on the division in this relationship to identify
	// infinities (we rely on the NaN to fail the test) otherwise
	// we compare Infs of the same sign and evaluate Infs as equal
	// independent of sign.
	return delta/math::Max(math::Abs(a), math::Abs(b)) <= tol
}

// Returns true when a and b are equal to within
// the absolute or relative tolerances.
// See EqualWithinAbs and EqualWithinRel for details.
fn EqualWithinAbsOrRel(a: f64, b: f64, absTol: f64, relTol: f64): bool {
	return EqualWithinAbs(a, b, absTol) || EqualWithinRel(a, b, relTol)
}

// Reports whether two values a and b are considered equal, allowing NaNs.
fn Equal(a: f64, b: f64): bool {
	return a == b || math::IsNaN(a) && math::IsNaN(b)
}

// Reports whether two values a and b are considered same.
// It returns true if both are NaN (Not a Number), or if they are exactly equal
// including matching their sign bits (distinguishing +0 and -0).
// If both are NaN, if guarantees payload equality for the quiet-NaNs.
fn Same(a: f64, b: f64): bool {
	match {
	| math::IsNaN(a) && math::IsNaN(b):
		// Inline implementation of the NaNPayload for a and b.
		return math::F64bits(a)&^nanMask == math::F64bits(b)&^nanMask
	| a == b:
		return math::Signbit(a) == math::Signbit(b)
	}
	return false
}

// Clamps x to the range [min, max].
fn Clamp(x: f64, min: f64, max: f64): f64 {
	return math::Max(min, math::Min(x, max))
}