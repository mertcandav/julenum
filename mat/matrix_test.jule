	{
		input: [[1, 2, 3, 4, 5]],
		data:  [3, 6, 9, 12, 15],
		k:     3,
	},
	{
		input: [[1, 2], [2, 3], [3, 4], [4, 5]],
		data:  [0, 0, 0, 0, 0, 0, 0, 0],
		k:     0,
