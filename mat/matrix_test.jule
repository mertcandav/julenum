struct testMatrixASM {
	xinput: [][]int
	yinput: [][]int
	data:   []int
	m:      int
	n:      int
}

fn testCaseMatrixASM(t: &testing::T, op: string, tests: []testMatrixASM, r: fn(test: testMatrixASM): Matrix[int]) {
	for _, test in tests {
		mut mat := r(test)
		if mat.m != test.m || mat.n != test.n {
			t.Errorf("expected ({} x {}), found ({}, {}), for {} {} {}", test.m, test.n, mat.m, mat.n, test.xinput, op, test.yinput)
			continue
		}
		if len(mat.data) != len(test.data) {
			t.Errorf("data expected {}, found {}, for {} {} {}", test.data, mat.data, test.xinput, op, test.yinput)
			continue
		}
		for i in test.data {
			if test.data[i] != mat.data[i] {
				t.Errorf("data expected {}, found {}, for {} {} {}", test.data, mat.data, test.xinput, op, test.yinput)
				break
			}
		}
	}
}

