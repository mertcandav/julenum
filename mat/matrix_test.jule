#test
fn testMatrixMul(t: &testing::T) {
	testCaseMatrixASM(t, "*", testsMatrixMul, fn|test| {
		mut x := NewFrom(test.xinput)
		y := NewFrom(test.yinput)
		x.Mul(&x, &y)
		return x
	})
}