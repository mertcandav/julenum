use "julenum/internal/chunk"
use "julenum/internal/ibits"
use "julenum/internal/imem"
use "std/comptime"
use "std/math"
use "std/math/cmplx"
use "std/runtime"
use "std/sync"

// Flags.
const (
	PARALLEL = 1 << iota
	STRASSEN
	STABLE
)

// A sub-matrix type.
struct matrixView[T: numeric] {
	m:      int
	n:      int
	stride: int
	data:   []T
}

impl matrixView {
	// Returns a view to a sub-matrix of m without allocating memory.
	#disable boundary
	fn getQuadrant(mut *self, rowStart: int, colStart: int, rows: int, cols: int): matrixView[T] {
		offset := rowStart + colStart*self.stride
		return matrixView[T]{
			m:      rows,
			n:      cols,
			stride: self.stride,
			data:   self.data[offset:], // View window starting from offset
		}
	}
}

// A matrix for type T.
// Uses internal mutable slice to store data.
// Matrix computations may use available capacity of the underlying slice
// to avoid making new allocation. So shared data needs extra attention.
// Any mutable operation may be reflected to shared common data.
// If you need to share same Matrix instance, use smart pointers.
// If you need to have guaranteed independent copy, use Copy with empty Matrix.
struct Matrix[T: numeric] {
	// Dimensions (M×N).
	m: int
	n: int

	// Data array, column-major.
	data: []T
}

impl Matrix {
	fn asView(*self): matrixView[T] {
		// Break immutability for but do not mutate them unsafely.
		// This method requires extra attention.
		return matrixView[T]{m: self.m, n: self.n, stride: self.m, data: unsafe { *(&self.data) }}
	}

	// Returns mutable copy of the internal data.
	// This is an unsafe function, any mutation may cause corruptions.
	unsafe fn Data(mut *self): []T {
		return self.data
	}

	// Returns dimensions of the Matrix (M×N).
	fn Dims(*self): (m: int, n: int) {
		return self.m, self.n
	}

	// Returns total element count of matrix (M×N).
	fn Size(*self): int {
		return self.m * self.n
	}

	// Reports whether the all values of Matrix are zero.
	//
	// Special cases are:
	//	Zero() = true, if Dims() == (0, 0)
	fn Zero(*self): bool {
		for _, x in self.data {
			if x != 0 {
				return false
			}
		}
		return true
	}

	// Reports whether the Matrix is a square matrix (M == N).
	fn Square(*self): bool {
		return self.m == self.n
	}

	// Reports whether the matrice (M×N) is scalar matrice of c.
	// This function only supports square matrices (M == N && N > 0).
	#disable boundary
	fn Scalar(*self, c: T): bool {
		if self.m != self.n || self.n <= 0 {
			panic("mat: Matrix.Scalar: determinant on non-square matrix")
		}
		mut i := 0
		mut j := 0 // 0 + i*self.m
		for i < self.n; i++ {
			mut k := j         // Start position of the column i.
			mut pivot := k + i // Pivot index for the c element.
			j += self.m        // Point to the index of the next column of matrix.
			for k < j; k++ {
				if k == pivot {
					if self.data[k] != c {
						return false
					}
				} else if self.data[k] != 0 {
					return false
				}
			}
		}
		return true
	}

	// Reports whether the matrice (M×N) is an identity matrice.
	// This function only supports square matrices (M == N && N > 0).
	fn Identity(*self): bool {
		return self.Scalar(1)
	}

	// Reports whether the matrice (M×N) is a diagonal matrice.
	// This function only supports square matrices (M == N && N > 0).
	fn Diagonal(*self): bool {
		if self.m != self.n || self.n <= 0 {
			panic("mat: Matrix.Diagonal: determinant on non-square matrix")
		}
		mut i := 0
		mut j := 0 // 0 + i*self.m
		for i < self.n; i++ {
			mut k := j         // Start position of the column i.
			mut pivot := k + i // Pivot index for the c element.
			j += self.m        // Point to the index of the next column of matrix.
			for k < j; k++ {
				if k == pivot {
					if self.data[k] == 0 {
						return false
					}
				} else if self.data[k] != 0 {
					return false
				}
			}
		}
		return true
	}

	// Returns value of the specified (i×j) position.
	// Position index starts from zero for column and row.
	//
	// Implementation will not check for boundaries, invalid position may cause panic.
	// To provide fast computation, it will not check whether the (i×j) is valid (M×N).
	fn Get(*self, i: int, j: int): T {
		return self.data[i+j*self.m]
	}

	// Sets value of the specified (i×j) position.
	// Position index starts from zero for column and row.
	//
	// Implementation will not check for boundaries, invalid position may cause panic.
	// To provide fast computation, it will not check whether the (i×j) is valid (M×N).
	fn Set(mut *self, i: int, j: int, value: T) {
		self.data[i+j*self.m] = value
	}

	// Reports whether self and z matrices are equal.
	#disable boundary
	fn Equal(*self, &z: *Matrix[T]): bool {
		if self.m != z.m || self.n != z.n {
			return false
		}
		mut i := 0
		for i < len(self.data); i++ {
			if self.data[i] != z.data[i] {
				return false
			}
		}
		return true
	}

	// Returns new buffer enough to store at least n values.
	fn make(mut *self, n: int): []T {
		// Reuse self capacity, if there is enough space.
		if n <= cap(self.data) {
			return self.data[:n]
		}
		return make([]T, n)
	}

	// Sets self to z, filled with k.
	// If self have enough capacity, Fill will use it to avoid making allocation.
	#disable boundary
	fn Fill(mut *self, &z: *Matrix[T], k: T) {
		// Make sure the self data have enough space.
		self.m, self.n = z.m, z.n
		self.data = self.make(self.Size())

		mut i := 0
		for i < len(z.data); i++ {
			self.data[i] = k
		}
	}

	// Copies z to self.
	//
	// If self have enough capacity, Copy will use it to avoid making allocation.
	fn Copy(mut *self, &z: *Matrix[T]) {
		// Fast case: if z and self is the same pointer.
		if self == z {
			return
		}

		// Make sure the self data have enough space.
		self.m, self.n = z.m, z.n
		self.data = self.make(self.Size())

		copy(self.data, z.data)
	}

	// Copies matrice z to self with custom (M×N) size.
	// If new size is larger, it will add padding with zeros.
	// If new size is smaller, it will cut rows and columns.
	//
	// If self have enough capacity, Resize will use it to avoid making allocation.
	// If M == 0 or N == 0, self will be (0×0). But keeps internal allocation.
	fn Resize(mut *self, &z: *Matrix[T], m: int, n: int) {
		if m == 0 || n == 0 {
			self.data = self.data[:0]
			self.m, self.n = 0, 0
			return
		}

		// Same size, copy directly.
		if self.m == m && self.n == n {
			// If z and self is the same pointer, avoid copying cost.
			if self != z {
				copy(self.data, z.data)
			}
			return
		}
		// Size is different, resize the matrix.

		let mut copySpace: []T
		if imem::Alias(self.data, z.data) {
			// Matrix self and matrix z have shared data.
			// We have to allocate new (M×N) Matrix to copy properly.
			copySpace = make([]T, m*n)
		} else {
			copySpace = self.make(m * n)
		}

		mut r := Matrix[T]{
			m:    m,
			n:    n,
			data: copySpace,
		}

		// New size is larger than old.
		if m >= self.m && n >= self.n {
			padAndCopy(&r, z)
		} else {
			// New size is smaller than old.
			copySubMatrix(&r, z, 0, 0, m, n)
		}

		*self = r
	}

	// Returns trace of matrix.
	// Panics if matrix is not a square matrix.
	//
	// Special cases are:
	//	Trace() = 0, for (0×0) matrices
	#disable boundary
	fn Trace(*self): T {
		if self.m != self.n {
			panic("mat: Matrix.Trace: trace computation on non-square matrix")
		}
		// Special case: trace of (0×0) matrix.
		if self.m == 0 {
			return 0
		}
		// Compute trace of self.

		mut n := self.data[0]
		mut i := 1
		mut k := i + self.m // i + i*self.m
		for i < self.m; i, k = i+1, k+self.m+1 {
			n += self.data[k]
		}
		return n
	}

	// Sets self to the transpose of the matrix z.
	// If self have enough capacity, Transpose will use it to avoid making allocation.
	// If z is a (0×0) matrix, self will be (0×0). But keeps internal allocation.
	#disable boundary
	fn Transpose(mut *self, &z: *Matrix[T]) {
		// Special case: (0×0) matrix.
		// Set self to (0×0), do not deallocate slice.
		if z.m == 0 && z.n == 0 {
			self.m, self.n = 0, 0
			return
		}

		// (M×N) matrix will become (N×M).
		// So size will not be changed.
		// Make sure the self data have enough space.
		if self == z || imem::Alias(self.data, z.data) {
			// Matrix self and matrix z have shared data.
			// We have to allocate new (N×M) Matrix to compute properly.
			mut r := uncheckedNew[T](z.n, z.m)
			r.Transpose(z)
			*self = r
			return
		} else {
			self.m, self.n = z.n, z.m
			self.data = self.make(self.Size())
		}
		// Compute transpose of z.

		mut i := 0
		mut zm := 0 + 0*z.m // j + i*z.m
		for i < z.n; i, zm = i+1, zm+z.m {
			mut sm := i + 0*self.m // i + j*self.m
			mut j := 0
			for j < z.m; j, sm = j+1, sm+self.m {
				self.data[sm] = z.data[j+zm]
			}
		}
	}

	// Sets self to the sum z+k.
	// If self have enough capacity, AddScalar will use it to avoid making allocation.
	// If z is a (0×0) matrix, self will be (0×0). But keeps internal allocation.
	#disable boundary
	fn AddScalar(mut *self, &z: *Matrix[T], k: T) {
		// Special case: (0×0) matrix.
		// Set self to (0×0), do not deallocate slice.
		if z.m == 0 && z.n == 0 {
			self.m, self.n = 0, 0
			return
		}

		// Make sure the self data have enough space.
		self.m, self.n = z.m, z.n
		self.data = self.make(self.Size())
		// Compute z+k.

		// Special case: k is zero. Result will always be same matrix.
		// Copy data instead of scalar addition.
		if k == 0 {
			copy(self.data, z.data)
			return
		}

		chunk::AddScalar(self.data, z.data, k)
	}

	// Sets self to the difference z-k.
	// If self have enough capacity, SubScalar will use it to avoid making allocation.
	// If z is a (0×0) matrix, self will be (0×0). But keeps internal allocation.
	#disable boundary
	fn SubScalar(mut *self, &z: *Matrix[T], k: T) {
		self.AddScalar(z, -k)
	}

	// Sets self to the product z*k.
	// If self have enough capacity, MulScalar will use it to avoid making allocation.
	// If z is a (0×0) matrix, self will be (0×0). But keeps internal allocation.
	fn MulScalar(mut *self, &z: *Matrix[T], k: T) {
		// Special case: (0×0) matrix.
		// Set self to (0×0), do not deallocate slice.
		if z.m == 0 && z.n == 0 {
			self.m, self.n = 0, 0
			return
		}

		// Special case: k is zero. Result will always be zero matrix.
		// Use Fill instead of scalar multiplication.
		if k == 0 {
			self.Fill(z, k)
			return
		}

		// Make sure the self data have enough space.
		self.m, self.n = z.m, z.n
		self.data = self.make(self.Size())
		// Compute z*k.

		// Special case: k is one. Result will always be same matrix.
		// Copy data instead of scalar multiplication.
		if k == 1 {
			copy(self.data, z.data)
			return
		}

		chunk::MulScalar(self.data, z.data, k)
	}

	// Sets self to the sum x+y.
	// If self have enough capacity, Add will use it to avoid making allocation.
	// If matrices are (0×0) matrix, self will be (0×0). But keeps internal allocation.
	fn Add(mut *self, &x: *Matrix[T], &y: *Matrix[T]) {
		if x.m != y.m || x.n != y.n {
			panic("mat: Matrix.Add: matrices have different size")
		}

		// Special case: (0×0) matrix.
		// Set self to (0×0), do not deallocate slice.
		if x.m == 0 && x.n == 0 {
			self.m, self.n = 0, 0
			return
		}

		// Make sure the self data have enough space.
		self.m, self.n = x.m, x.n
		self.data = self.make(self.Size())

		chunk::Add(self.data, x.data, y.data)
	}

	// Sets self to the difference x-y.
	// If self have enough capacity, Sub will use it to avoid making allocation.
	// If matrices are (0×0) matrix, self will be (0×0). But keeps internal allocation.
	fn Sub(mut *self, &x: *Matrix[T], &y: *Matrix[T]) {
		if x.m != y.m || x.n != y.n {
			panic("mat: Matrix.Sub: matrices have different size")
		}

		// Special case: (0×0) matrix.
		// Set self to (0×0), do not deallocate slice.
		if x.m == 0 && x.n == 0 {
			self.m, self.n = 0, 0
			return
		}

		// Make sure the self data have enough space.
		self.m, self.n = x.m, x.n
		self.data = self.make(self.Size())

		chunk::Sub(self.data, x.data, y.data)
	}

	// Internal implementation of [Mul] and [MulEx].
	// Operands self, x and y must be checked and non-nil.
	#disable nilptr boundary
	fn mulEx(mut *self, &x: *Matrix[T], &y: *Matrix[T], flags: int) {
		n, mut useStrassen := checkStrassen(x.m, x.n, y.n, flags)
		// If we will use Strassen algorithm and numerical stability
		// is a concern, check for numeric type. Strassen algoritm is not
		// numerically stable for flotaing-point types.
		// If type is not suitable for Strassen, use basic multiplication.
		const kind = comptime::Typeof(T).Kind()
		useStrassen = useStrassen &&
			(flags&STABLE == 0 ||
				kind != comptime::F32 &&
					kind != comptime::F64 &&
					kind != comptime::Cmplx64 &&
					kind != comptime::Cmplx128)
		if !useStrassen {
			// self is an alias for x or y - cannot reuse.
			// We have to allocate new Matrix to compute properly.
			if self == x || self == y ||
				imem::Alias(self.data, x.data) || imem::Alias(self.data, y.data) {
				mut r := uncheckedNew[T](x.m, y.n)
				basicMul(&r, x, y, flags)
				*self = r
				return
			}

			// Make sure the self data have enough space.
			self.m, self.n = x.m, y.n
			self.data = self.make(self.Size())

			basicMul(self, x, y, flags)
			return
		}
		// Matrices are big for basic multiplication.
		// Use Strassen algorithm to compute efficiently.
		// https://en.wikipedia.org/wiki/Strassen_algorithm

		// Determine smallest power-of-two dimension to pad matrices to.
		// Ensures Strassen recursion works correctly.
		k := ibits::NextPowerOfTwo(n)

		// Total common buffer allocation size estimation for Strassen implementation:
		// Let n = size
		// - Padded matrices (worst case): 3n² (A, B, and C)
		// - We use Matrix Views so we DO NOT allocate sub-quadrants.
		// - Recursive temporary space per level (9 matrices: M1-M7, S1, S2): 9 × (n/2)² = (9/4) × n²
		// - Depth of recursion: log₂(n / threshold)
		// - Recursive workspace total:
		//   S(n) = (9/4)n² + (9/16)n² + ...
		//   This is a geometric series: S ≈ 3n² (as n → ∞)
		// => Total = 3n² (pads) + 3n² (recursion) = 6n²
		mut strassenSize := 6 * k * k

		// Determine whether the input matrices needs padding.
		xPadNeed := !ibits::IsPowerOfTwo(x.m) || !ibits::IsPowerOfTwo(x.n)
		yPadNeed := !ibits::IsPowerOfTwo(y.m) || !ibits::IsPowerOfTwo(y.n)

		// Remove size of the matrices, if it does not need padding.
		// It helps to reduce size of the common buffer allocation.
		if !xPadNeed {
			strassenSize -= x.m * x.n
		}
		if !yPadNeed {
			strassenSize -= y.m * y.n
		}

		// strassenSpace is a single buffer to compute x*y with Strassen algorithm.
		// It will be used for internal matrix data and the final matrix.
		// Once allocated, it will be used for the whole computation, no extra allocation.
		let mut strassenSpace: []T
		if self == x || self == y ||
			imem::Alias(self.data, x.data) || imem::Alias(self.data, y.data) {
			// self is an alias for x or y - cannot reuse.
			// We have to allocate new Matrix to compute properly.
			strassenSpace = make([]T, strassenSize)
		} else if cap(self.data) >= strassenSize {
			// In this case, we have enough slice capacity or length to store result.
			// To avoid making allocation, use the full capacity if needed.
			strassenSpace = self.data[:strassenSize]
		} else {
			// No enough space, we have to allocate new slice.
			strassenSpace = make([]T, strassenSize)
		}

		// Allocate z first to get end of the space.
		// It is important to save whole buffer allocation.
		// In the final stage, we will keep allocation for the result.
		// For the next computation, this buffer will be available.
		// To achieve that, the result matrix will be copied from the head of this allocation.
		// The z matrix will be result with possible padding.
		// To avoid collision during the copy, use the trailing space for z.
		zpos := len(strassenSpace) - k*k
		mut z := matrixView[T]{
			m:      k,
			n:      k,
			stride: k,
			data:   strassenSpace[zpos:],
		}
		strassenSpace = strassenSpace[:zpos]
		mut r := strassenSpace[:x.m*y.n] // The final result allocation.

		// Allocate padded matrices from common buffer, if needed.
		let mut xPad: matrixView[T]
		let mut yPad: matrixView[T]
		if xPadNeed {
			// Copy input matrices into zero-padded square matrices.
			xPad = getView(k, k, &strassenSpace)
			padAndCopyView(xPad, x)
		} else {
			xPad.m = x.m
			xPad.n = x.n
			xPad.stride = x.m
			// Break immutability, it will not be mutated.
			xPad.data = unsafe { *&x.data }
		}
		if yPadNeed {
			// Copy input matrices into zero-padded square matrices.
			yPad = getView(k, k, &strassenSpace)
			padAndCopyView(yPad, y)
		} else {
			yPad.m = y.m
			yPad.n = y.n
			yPad.stride = y.m
			// Break immutability, it will not be mutated.
			yPad.data = unsafe { *&y.data }
		}

		// Time to compute the product x*y using Strassen algorithm.
		strassen(z, xPad, yPad, strassenSpace, flags)

		// Set result to self.
		self.m, self.n = x.m, y.n
		self.data = r

		// The z matrix is the raw result now.
		// If it have same size with the actual result matrix, copy data directly.
		// Otherwise, extract resulting matrix from top-left of padded output.
		if z.m == self.m && z.n == self.n {
			copy(self.data, z.data)
		} else {
			mut j := 0
			for j < self.n; j++ {
				copy(self.data[j*self.m:j*self.m+self.m], z.data[j*z.m:j*z.m+self.m])
			}
		}
	}

	// Sets self to the product x*y.
	// If self have enough capacity, Mul will use it to avoid making allocation.
	// Equals to [Matrix.MulEx(x, y, PARALLEL|STRASSEN|STABLE)]
	fn Mul(mut *self, &x: *Matrix[T], &y: *Matrix[T]) {
		if x.m < 1 || x.n < 1 ||
			y.m < 1 || y.n < 1 {
			panic("mat: Matrix.Mul: matrices must have at least (1×1) size")
		}
		if x.n != y.m {
			panic("mat: Matrix.Mul: dimensions are not compatible for multiplication")
		}
		_ = *self // Pointer check.
		self.mulEx(x, y, PARALLEL|STRASSEN|STABLE)
	}

	// Sets self to the product x*y.
	// If self have enough capacity, MulEx will use it to avoid making allocation.
	//
	// Flags:
	//	PARALLEL: performs parallel computation when it is suitable.
	//	STRASSEN: uses Strassen algorithm when it is suitable.
	//	STABLE: prioritizes numerical stability.
	fn MulEx(mut *self, &x: *Matrix[T], &y: *Matrix[T], flags: int) {
		if x.m < 1 || x.n < 1 ||
			y.m < 1 || y.n < 1 {
			panic("mat: Matrix.MulEx: matrices must have at least (1×1) size")
		}
		if x.n != y.m {
			panic("mat: Matrix.MulEx: dimensions are not compatible for multiplication")
		}
		_ = *self // Pointer check.
		self.mulEx(x, y, flags)
	}

	// Computes the determinant of the matrix.
	// This function only supports square matrices (M == N && N > 0).
	//
	// For integer and floating-point types, computations are performed using 64-bit floating-point precision.
	// For complex types, computations use 128-bit complex precision.
	// The result is returned as type T, which may cause rounding errors or loss of precision.
	// To preserve exact results, use an f64 or cmplx128 matrix.
	fn Det(*self): T {
		m, n := self.m, self.n
		if m != n || n <= 0 {
			panic("mat: Matrix.Det: determinant on non-square matrix")
		}

		const match comptime::Typeof(T).Kind() {
		| comptime::Cmplx64 | comptime::Cmplx128:
			// complex
			return T(det(self, cmplx::Abs))
		|:
			// integer or floating-point
			return T(det(self, math::Abs))
		}
	}

	// Computes the sign and natural logarithm of the absolute value of the determinant of the matrix.
	// Returns (sign, logdet). If the matrix is singular, returns (0, -Inf).
	// This function only supports square matrices (M == N && N > 0).
	//
	// For integer and floating-point types, computations are performed using 64-bit floating-point precision.
	// For complex types, computations use 128-bit complex precision.
	// The result is returned as type T, which may cause rounding errors or loss of precision.
	// To preserve exact results, use an f64 or cmplx128 matrix.
	//
	// NOTICE (floating-point types)
	//	Let (sign, logdet) = Slogdet()
	//	- Mathematically: Det() = sign * exp(logdet)
	//	- In practice:    Det() ≈ sign * exp(logdet)
	//	                  due to floating-point rounding.
	//
	// NOTICE (complex types)
	//	Let (sign, logdet) = Slogdet()
	//	- Mathematically: Det() = cmplx(real(sign)*exp(logdet), imag(sign)*exp(logdet))
	//	- In practive:    Det() ≈ cmplx(real(sign)*exp(logdet), imag(sign)*exp(logdet))
	//	                  due to floating-point rounding.
	#disable boundary
	fn Slogdet(*self): (sign: T, logdet: f64) {
		m, n := self.m, self.n
		if m != n || n <= 0 {
			panic("mat: Matrix.Slogdet: determinant on non-square matrix")
		}

		const match comptime::Typeof(T).Kind() {
		| comptime::Cmplx64 | comptime::Cmplx128:
			// complex
			_sign, (logdet) := slogdetCmplx(self)
			return T(_sign), logdet
		|:
			// integer or floating-point
			_sign, (logdet) := slogdet(self)
			return T(_sign), logdet
		}
	}

	// Sets self to A⁻¹, inverse of the matrix a.
	// This function only supports square matrices (M == N && N > 0).
	// If self have enough capacity, Mul will use it to avoid making allocation.
	// It panics if matrix a is singular.
	//
	// For integer and floating-point types, computations are performed using 64-bit floating-point precision.
	// For complex types, computations use 128-bit complex precision.
	// The result is handled as type T, which may cause rounding errors or loss of precision.
	// To preserve exact results, use an f64 or cmplx128 matrix.
	fn Inv(mut *self, &a: *Matrix[T]) {
		m, n := self.m, self.n
		if m != n || n <= 0 {
			panic("mat: Matrix.Inv: inverse on non-square matrix")
		}

		const match comptime::Typeof(T).Kind() {
		| comptime::Cmplx64 | comptime::Cmplx128:
			// complex
			inv(self, a, cmplx::Abs)
		|:
			// integer or floating-point
			inv(self, a, math::Abs)
		}
	}
}

// Same as New, but it does not checks anything.
fn uncheckedNew[T: numeric](m: int, n: int): Matrix[T] {
	let mut mat: Matrix[T]
	mat.m, mat.n = m, n
	mat.data = make([]T, m*n)
	return mat
}

// Returns new empty (0×0) Matrix for type T.
fn Empty[T: numeric](): Matrix[T] {
	return uncheckedNew[T](0, 0)
}

// Returns new (M×N) zero Matrix for type T.
//
// Constraints:
//	m >= 0
//	n >= 0
fn New[T: numeric](m: int, n: int): Matrix[T] {
	if m < 0 || n < 0 {
		panic("mat: New: m < 0 || n < 0")
	}
	return uncheckedNew[T](m, n)
}

// Returns new (M×N) Matrix for type T.
// Uses len(values) for m, len(values[1]) for n.
// Panics if all rows are not have same amount of values.
//
// Special cases are:
//	NewFrom(values) = (0×0) Matrix, if len(values) == 0
//	NewFrom(values) = (0×0) Matrix, if len(values) == 1 && len(values[1]) == 0
//
// Example Use:
//
//	mat::NewFrom([
//		[1, 2, 4],
//		[3, 4, 5],
//	])
//
//	Equals to:
//		A = ⎡1 2 4⎤
//		    ⎣3 4 5⎦(2×3)
#disable boundary
fn NewFrom[T: numeric](values: [][]T): Matrix[T] {
	m := len(values)
	if m == 0 {
		return uncheckedNew[T](0, 0)
	}

	n := len(values[0])
	if n == 0 {
		return uncheckedNew[T](0, 0)
	}

	// Make sure all rows have same amount of values.
	// It also makes safe array access with no boundary check.
	mut j := 1
	for j < m; j++ {
		if len(values[j]) != n {
			panic("mat: NewFrom: rows have different amount of values")
		}
	}
	j = 0 // Set to zero to reuse.

	mut mat := uncheckedNew[T](m, n)
	mut k := 0
	for j < n; j++ {
		mut i := 0
		for i < m; i++ {
			mat.data[k] = values[i][j]
			k++
		}
	}

	return mat
}

#disable nilptr boundary
fn det[T: numeric, Prec: f64 | cmplx128](&a: *Matrix[T], abs: fn(Prec): f64): Prec {
	m, n := a.m, a.n

	// Use direct formulas for small matrices.
	match n {
	| 1:
		// 1×1 matrix: det(A) = a₀₀
		return Prec(a.data[0])
	| 2:
		// 2×2 matrix:
		// det(A) = a₀₀·a₁₁ - a₀₁·a₁₀
		a_00 := Prec(a.data[0+0*m])
		a_11 := Prec(a.data[1+1*m])
		a_01 := Prec(a.data[0+1*m])
		a_10 := Prec(a.data[1+0*m])
		return a_00*a_11 - a_01*a_10
	| 3:
		// 3×3 matrix using cofactor expansion along the first row:
		// det(A) = a₀₀·(a₁₁·a₂₂ - a₁₂·a₂₁)
		//        - a₀₁·(a₁₀·a₂₂ - a₁₂·a₂₀)
		//        + a₀₂·(a₁₀·a₂₁ - a₁₁·a₂₀)
		a_00 := Prec(a.data[0+0*m])
		a_11 := Prec(a.data[1+1*m])
		a_22 := Prec(a.data[2+2*m])
		a_12 := Prec(a.data[1+2*m])
		a_21 := Prec(a.data[2+1*m])
		a_01 := Prec(a.data[0+1*m])
		a_10 := Prec(a.data[1+0*m])
		a_20 := Prec(a.data[2+0*m])
		a_02 := Prec(a.data[0+2*m])
		return a_00*(a_11*a_22-a_12*a_21) -
			a_01*(a_10*a_22-a_12*a_20) +
			a_02*(a_10*a_21-a_11*a_20)
	}

	// Use LU decomposition with partial pivoting for larger ones.
	// See: https://en.wikipedia.org/wiki/LU_decomposition
	//
	// For general n×n matrices (n > 3), we use LU decomposition with partial pivoting:
	// If A = P·L·U, then det(A) = det(P)·det(L)·det(U)
	// - det(L) = 1 (L is unit lower triangular)
	// - det(U) = ∏ Uᵢᵢ
	// - det(P) = (−1)^s, where s is the number of row swaps (sign of permutation)

	mut LU := make([]Prec, a.Size())
	for i in LU {
		LU[i] = Prec(a.data[i])
	}

	// Tracks the sign of the determinant due to row swaps.
	mut detSign := Prec(1)

	mut k := 0
	mut km := 0 * m // k * m
	for k < n; k, km = k+1, km+m {
		// Pivot selection: find the row with the largest absolute value in column k.
		mut pivotIndex := k
		mut maxPivot := abs(LU[k+km])
		mut i := k + 1
		for i < n; i++ {
			val := abs(LU[i+km])
			if val > maxPivot {
				maxPivot = val
				pivotIndex = i
			}
		}

		// If the pivot is too small, matrix is singular or nearly singular.
		if maxPivot == 0 {
			return 0
		}

		// Swap rows k and pivotIndex if necessary.
		if pivotIndex != k {
			mut j := 0
			mut jm := 0 * m // j * m
			for j < n; j, jm = j+1, jm+m {
				LU[k+jm], LU[pivotIndex+jm] = LU[pivotIndex+jm], LU[k+jm]
			}
			detSign = -detSign
		}

		pivot := LU[k+km]

		// Elimination: store multipliers in lower triangle, update submatrix.
		i = k + 1
		for i < n; i++ {
			LU[i+km] /= pivot
			factor := LU[i+km]
			mut j := k + 1
			mut jm := j * m
			for j < n; j, jm = j+1, jm+m {
				LU[i+jm] -= factor * LU[k+jm]
			}
		}
	}

	// Compute determinant: product of diagonal entries of U scaled by the permutation sign.
	mut det := detSign
	mut i := 0
	k = 0 + 0*m // i + i*m
	for i < n; i, k = i+1, k+m+1 {
		det *= LU[k]
	}
	return det
}

#disable nilptr boundary
fn slogdet[T: integer | float](&a: *Matrix[T]): (sign: f64, logdet: f64) {
	m, n := a.m, a.n

	// Use direct formulas for small matrices.
	match n {
	| 1:
		// 1×1 matrix: det(A) = a₀₀
		det := f64(a.data[0])
		if det == 0 {
			return 0, math::Inf(-1)
		}
		return math::Copysign(1, det), math::Log(math::Abs(det))
	| 2:
		// 2×2 matrix:
		// det(A) = a₀₀·a₁₁ - a₀₁·a₁₀
		a_00 := f64(a.data[0+0*m])
		a_11 := f64(a.data[1+1*m])
		a_01 := f64(a.data[0+1*m])
		a_10 := f64(a.data[1+0*m])
		det := a_00*a_11 - a_01*a_10
		if det == 0 {
			return 0, math::Inf(-1)
		}
		return math::Copysign(1, det), math::Log(math::Abs(det))
	| 3:
		// 3×3 matrix using cofactor expansion along the first row:
		// det(A) = a₀₀·(a₁₁·a₂₂ - a₁₂·a₂₁)
		//        - a₀₁·(a₁₀·a₂₂ - a₁₂·a₂₀)
		//        + a₀₂·(a₁₀·a₂₁ - a₁₁·a₂₀)
		a_00 := f64(a.data[0+0*m])
		a_11 := f64(a.data[1+1*m])
		a_22 := f64(a.data[2+2*m])
		a_12 := f64(a.data[1+2*m])
		a_21 := f64(a.data[2+1*m])
		a_01 := f64(a.data[0+1*m])
		a_10 := f64(a.data[1+0*m])
		a_20 := f64(a.data[2+0*m])
		a_02 := f64(a.data[0+2*m])
		det := a_00*(a_11*a_22-a_12*a_21) -
			a_01*(a_10*a_22-a_12*a_20) +
			a_02*(a_10*a_21-a_11*a_20)
		if det == 0 {
			return 0, math::Inf(-1)
		}
		return math::Copysign(1, det), math::Log(math::Abs(det))
	}

	// Use LU decomposition with partial pivoting for larger ones.
	// See: https://en.wikipedia.org/wiki/LU_decomposition
	//
	// For general n×n matrices (n > 3), we use LU decomposition with partial pivoting:
	// If A = P·L·U, then det(A) = det(P)·det(L)·det(U)
	// - det(L) = 1 (L is unit lower triangular)
	// - det(U) = ∏ Uᵢᵢ
	// - det(P) = (−1)^s, where s is the number of row swaps (sign of permutation)

	mut LU := make([]f64, a.Size())
	for i in LU {
		LU[i] = f64(a.data[i])
	}

	sign = 1.0 // Tracks the sign of the determinant due to row swaps.
	logdet = 0

	mut k := 0
	mut km := 0 * m // k * m
	for k < n; k, km = k+1, km+m {
		// Pivot selection: find the row with the largest absolute value in column k.
		mut pivotIndex := k
		mut maxPivot := math::Abs(LU[k+km])
		mut i := k + 1
		for i < n; i++ {
			val := math::Abs(LU[i+km])
			if val > maxPivot {
				maxPivot = val
				pivotIndex = i
			}
		}

		// If the pivot is too small, matrix is singular or nearly singular.
		if maxPivot == 0 {
			return 0, math::Inf(-1)
		}

		// Swap rows k and pivotIndex if necessary.
		if pivotIndex != k {
			mut j := 0
			mut jm := 0 * m // j * m
			for j < n; j, jm = j+1, jm+m {
				LU[k+jm], LU[pivotIndex+jm] = LU[pivotIndex+jm], LU[k+jm]
			}
			sign = -sign
		}

		pivot := LU[k+km]
		logdet += math::Log(math::Abs(pivot))
		sign *= math::Copysign(1, pivot)

		// Elimination: store multipliers in lower triangle, update submatrix.
		i = k + 1
		for i < n; i++ {
			LU[i+km] /= pivot
			factor := LU[i+km]
			mut j := k + 1
			mut jm := j * m
			for j < n; j, jm = j+1, jm+m {
				LU[i+jm] -= factor * LU[k+jm]
			}
		}
	}

	return
}

#disable nilptr boundary
fn slogdetCmplx[T: cmplx](&a: *Matrix[T]): (sign: cmplx128, logdet: f64) {
	m, n := a.m, a.n

	// Use direct formulas for small matrices.
	match n {
	| 1:
		// 1×1 matrix: det(A) = a₀₀
		det := cmplx128(a.data[0])
		if det == 0 {
			return 0, math::Inf(-1)
		}
		phase := cmplx::Rect(1, cmplx::Phase(det))
		return phase, math::Log(cmplx::Abs(det))
	| 2:
		// 2×2 matrix:
		// det(A) = a₀₀·a₁₁ - a₀₁·a₁₀
		a_00 := cmplx128(a.data[0+0*m])
		a_11 := cmplx128(a.data[1+1*m])
		a_01 := cmplx128(a.data[0+1*m])
		a_10 := cmplx128(a.data[1+0*m])
		det := a_00*a_11 - a_01*a_10
		if det == 0 {
			return 0, math::Inf(-1)
		}
		phase := cmplx::Rect(1, cmplx::Phase(det))
		return phase, math::Log(cmplx::Abs(det))
	| 3:
		// 3×3 matrix using cofactor expansion along the first row:
		// det(A) = a₀₀·(a₁₁·a₂₂ - a₁₂·a₂₁)
		//        - a₀₁·(a₁₀·a₂₂ - a₁₂·a₂₀)
		//        + a₀₂·(a₁₀·a₂₁ - a₁₁·a₂₀)
		a_00 := cmplx128(a.data[0+0*m])
		a_11 := cmplx128(a.data[1+1*m])
		a_22 := cmplx128(a.data[2+2*m])
		a_12 := cmplx128(a.data[1+2*m])
		a_21 := cmplx128(a.data[2+1*m])
		a_01 := cmplx128(a.data[0+1*m])
		a_10 := cmplx128(a.data[1+0*m])
		a_20 := cmplx128(a.data[2+0*m])
		a_02 := cmplx128(a.data[0+2*m])
		det := a_00*(a_11*a_22-a_12*a_21) -
			a_01*(a_10*a_22-a_12*a_20) +
			a_02*(a_10*a_21-a_11*a_20)
		if det == 0 {
			return 0, math::Inf(-1)
		}
		phase := cmplx::Rect(1, cmplx::Phase(det))
		return phase, math::Log(cmplx::Abs(det))
	}

	// Use LU decomposition with partial pivoting for larger ones.
	// See: https://en.wikipedia.org/wiki/LU_decomposition
	//
	// For general n×n matrices (n > 3), we use LU decomposition with partial pivoting:
	// If A = P·L·U, then det(A) = det(P)·det(L)·det(U)
	// - det(L) = 1 (L is unit lower triangular)
	// - det(U) = ∏ Uᵢᵢ
	// - det(P) = (−1)^s, where s is the number of row swaps (sign of permutation)

	mut LU := make([]cmplx128, a.Size())
	for i in LU {
		LU[i] = cmplx128(a.data[i])
	}

	sign = 1 // Tracks the sign of the determinant due to row swaps.
	logdet = 0

	mut k := 0
	mut km := 0 * m // k * m
	for k < n; k, km = k+1, km+m {
		// Pivot selection: find the row with the largest absolute value in column k.
		mut pivotIndex := k
		mut maxPivot := cmplx::Abs(LU[k+km])
		mut i := k + 1
		for i < n; i++ {
			val := cmplx::Abs(LU[i+km])
			if val > maxPivot {
				maxPivot = val
				pivotIndex = i
			}
		}

		// If the pivot is too small, matrix is singular or nearly singular.
		if maxPivot == 0 {
			return 0, math::Inf(-1)
		}

		// Swap rows k and pivotIndex if necessary.
		if pivotIndex != k {
			mut j := 0
			mut jm := 0 * m // j * m
			for j < n; j, jm = j+1, jm+m {
				LU[k+jm], LU[pivotIndex+jm] = LU[pivotIndex+jm], LU[k+jm]
			}
			sign = -sign
		}

		pivot := LU[k+km]
		logdet += math::Log(cmplx::Abs(pivot))
		// Multiply sign by pivot/|pivot| to track phase.
		sign *= cmplx::Rect(1, cmplx::Phase(pivot))

		// Elimination: store multipliers in lower triangle, update submatrix.
		i = k + 1
		for i < n; i++ {
			LU[i+km] /= pivot
			factor := LU[i+km]
			mut j := k + 1
			mut jm := j * m
			for j < n; j, jm = j+1, jm+m {
				LU[i+jm] -= factor * LU[k+jm]
			}
		}
	}

	return
}

#disable nilptr boundary
fn inv[T: numeric, Prec: f64 | cmplx128](mut &z: *Matrix[T], &a: *Matrix[T], abs: fn(Prec): f64) {
	n := a.n

	// Use direct formula for small 1×1 matrice.
	// For 2×2 or 3×3 matrices, there may be rounding errors, due to formula;
	//	- 2×2 matrices: A = [a b; c d], A⁻¹ = (1/det(A)) * [d -b; -c a]
	//	- 3×3 matrices: A⁻¹ = (1/det(A))·adj(A) (adjugate method)
	// Using LU decomposition for them gives more accurate results.
	if n == 1 {
		// 1×1 matrix:
		// A = [a], A⁻¹ = [1/det]
		val := a.data[0]
		if val == 0 {
			panic("mat: Matrix.Inv: cannot compute the inverse of a singular matrix")
		}
		z.m, z.n = 1, 1
		z.data = z.make(z.Size())
		z.data[0] = T(Prec(1) / Prec(val))
		return
	}

	// Use LU decomposition with partial pivoting for larger ones.
	// See: https://en.wikipedia.org/wiki/LU_decomposition
	//
	// The LU decomposition factorizes the matrix as A = P·L·U,
	// where:
	// - P is a permutation matrix (representing row swaps),
	// - L is a unit lower triangular matrix (diagonal entries are 1), so det(L) = 1,
	// - U is an upper triangular matrix, det(U) = product of U's diagonal entries.
	//
	// If A = P·L·U, then A⁻¹ = U⁻¹·L⁻¹·P
	//
	// To find the inverse, for each column eᵢ of the identity matrix,
	// we solve A·x = eᵢ by forward and backward substitution:
	//   1. Solve L·y = P·eᵢ  (forward substitution)
	//   2. Solve U·x = y     (backward substitution)
	// The solution vectors x form the columns of A⁻¹.
	//
	// This approach is efficient and numerically stable for general n×n matrices.

	// Convert the input matrix to row-major layout for LU decomposition.
	// LU[i*n + j] stores element at row i, column j.
	mut LU := make([]Prec, n*n)

	// Copy column-major a matrix to LU in row-major order.
	mut i := 0          // column
	mut am := 0 + 0*a.m // j + i*a.m
	for i < n; i, am = i+1, am+a.m {
		mut j := 0        // row
		mut jn := 0*n + 0 // j*n + i
		for j < n; j, jn = j+1, jn+n {
			LU[jn+i] = Prec(a.data[j+am])
		}
	}

	// Initialize the permutation vector for row swaps.
	mut piv := make([]int, n)
	i = 0
	for i < len(piv); i++ {
		piv[i] = i
	}

	// Perform LU decomposition with partial pivoting.
	// The decomposition is done in-place on the LU matrix in row-major layout.
	mut k := 0
	mut kn := 0 * n // k * n
	for k < n; k, kn = k+1, kn+n {
		// Pivot selection: find the row with the largest absolute value in column k.
		mut pivotIndex := k
		mut maxPivot := abs(Prec(LU[kn+k]))
		i = k + 1
		mut ni := i*n + k
		for i < n; i, ni = i+1, ni+n {
			val := abs(Prec(LU[ni]))
			if val > maxPivot {
				maxPivot = val
				pivotIndex = i
			}
		}

		if maxPivot == 0 {
			panic("mat: Matrix.Inv: cannot compute the inverse of a singular matrix")
		}

		// Swap rows k and pivotIndex in LU and update the pivot vector.
		if pivotIndex != k {
			i = 0                 // column
			ni = pivotIndex*n + 0 // pivotIndex*n + i
			for i < n; i, ni = i+1, ni+1 {
				LU[kn+i], LU[ni] = LU[ni], LU[kn+i]
			}
			piv[k], piv[pivotIndex] = piv[pivotIndex], piv[k]
		}

		pivot := LU[kn+k]

		// Elimination: update submatrix and store multipliers in the lower triangle.
		i = k + 1
		ni = i * n
		for i < n; i, ni = i+1, ni+n {
			LU[ni+k] /= pivot
			factor := LU[ni+k]
			mut j := k + 1
			for j < n; j++ {
				LU[ni+j] -= factor * LU[kn+j]
			}
		}
	}

	// Make sure the z data have enough space.
	z.m, z.n = n, n
	z.data = z.make(z.Size())

	// Workspace: b (RHS), y (solution of Ly=b), x (solution of Ux=y)
	// All allocated in a single slice to avoid repeated allocations.
	mut tmp := make([]Prec, 3*n)
	mut b := tmp[:n]
	mut y := tmp[n : 2*n]
	mut x := tmp[2*n : 3*n]

	// Solve A·X = I one column at a time.
	k = 0
	kn = 0 * n // k * n
	for k < n; k, kn = k+1, kn+n {
		// Set b = column col of the permuted identity matrix: P·eᵢ
		i = 0
		for i < n; i++ {
			if piv[i] == k {
				b[i] = 1
			} else {
				b[i] = 0
			}
		}

		// Forward substitution: solve L·y = b
		// L is unit lower triangular (diagonal entries are 1)
		i = 0
		mut ni := 0 * n // i * n
		for i < n; i, ni = i+1, ni+n {
			mut sum := b[i]
			mut j := 0
			for j < i; j++ {
				sum -= LU[ni+j] * y[j]
			}
			y[i] = sum
		}

		// Backward substitution: solve U·x = y
		// U is upper triangular.
		i = n - 1
		ni = i * n
		for i >= 0; i, ni = i-1, ni-n {
			mut sum := y[i]
			mut j := i + 1
			for j < n; j++ {
				sum -= LU[ni+j] * x[j]
			}
			x[i] = sum / LU[ni+i]
		}

		// Store the computed column x into the inverse matrix.
		// Note: z.data is in column-major layout, so column-major write.
		i = 0
		for i < n; i++ {
			z.data[kn+i] = T(x[i])
		}
	}
}

// Adds x and y, storing the result in z using matrix views.
#disable boundary
fn addView[T](mut z: matrixView[T], x: matrixView[T], y: matrixView[T]) {
	mut j := 0
	for j < z.n; j++ {
		zj := j * z.stride
		xj := j * x.stride
		yj := j * y.stride

		chunk::Add(z.data[zj:zj+z.m], x.data[xj:], y.data[yj:])
	}
}

// Subtracts y from x, storing the result in z using matrix views.
#disable boundary
fn subView[T](mut z: matrixView[T], x: matrixView[T], y: matrixView[T]) {
	mut j := 0
	for j < z.n; j++ {
		zj := j * z.stride
		xj := j * x.stride
		yj := j * y.stride

		chunk::Sub(z.data[zj:zj+z.m], x.data[xj:], y.data[yj:])
	}
}

// Basic matrix multiplication implementation.
// Multiplies x and y and leaves the result in z.
// z must be have enough space for the product x*k.
// It will not update dimensions of the z.
#disable nilptr
fn basicMul[T: numeric](mut &z: *Matrix[T], &x: *Matrix[T], &y: *Matrix[T], flags: int) {
	basicMulView(z.asView(), x.asView(), y.asView(), flags)
}

const (
	// Defines the L1/L2 cache tiling block size for matrix multiplication.
	// A block size of 64 balances register pressure and keeps working sub-matrices
	// within CPU cache lines, minimizing cache misses for column-major layouts.
	blockSize = 64

	// Minnimum block-size for parallel computation.
	minParBlock = 4
)

// Returns the number of divisions of the dimension length
// with the given block size.
fn blocks(dim: int, bsize: int): int {
	return (dim + bsize - 1) / bsize
}

// Parallel implementation of `basicMulView`, works with multiple threads.
#disable boundary
fn basicMulView_Parallel[T](mut z: matrixView[T], mut x: matrixView[T], mut y: matrixView[T]) {
	m := x.m
	k := x.n
	n := y.n

	maxKLen := k
	parBlocks := blocks(m, blockSize) * blocks(n, blockSize)
	if parBlocks < minParBlock {
		basicMulView_Serial(z, x, y)
		return
	}

	mut wg := sync::BlockingWaitGroup.New()
	wg.Add(parBlocks)
	defer { wg.Wait() }

	mut i := 0
	for i < m; i += blockSize {
		mut j := 0
		for j < n; j += blockSize {
			runtime::Task(fn() {
				defer { wg.Done() }

				mut leni := blockSize
				if i+leni > m {
					leni = m - i
				}
				mut lenj := blockSize
				if j+lenj > n {
					lenj = n - j
				}

				mut zView := z.getQuadrant(i, j, leni, lenj)

				mut k := 0
				for k < maxKLen; k += blockSize {
					mut lenk := blockSize
					if k+lenk > maxKLen {
						lenk = maxKLen - k
					}

					xView := x.getQuadrant(i, k, leni, lenk)
					yView := y.getQuadrant(k, j, lenk, lenj)

					basicMulView_Serial(zView, xView, yView)
				}
			})
		}
	}
}

// Serial implementation of `basicMulView`, works with single thread.
#disable boundary
fn basicMulView_Serial[T](mut z: matrixView[T], x: matrixView[T], y: matrixView[T]) {
	xm := x.m
	xn := x.n
	yn := y.n

	// Quick return for empty inner dimensions.
	if xn == 0 {
		return
	}

	unsafe {
		// Raw pointers to bypass slice indexing overhead and enable fast arithmetic.
		mut zPtr := &z.data[0]
		mut xPtr := &x.data[0]
		mut yPtr := &y.data[0]

		// Block dimensions tuned specifically for cache sizes.
		const MC = 128 // Block size for 'i' dimension.
		const KC = 64  // Block size for 'k' dimension.
		const NC = 128 // Block size for 'j' dimension.

		// Stack-allocated packing buffer to retain sub-matrix blocks of X
		// contiguous in cache memory, eliminating heap allocation overhead.
		let mut packedX: [MC * KC]T
		mut pXPtr := &packedX[0]

		// Outer loop: Iterate over column blocks of Y and Z (j dimension).
		mut jj := 0
		for jj < yn; jj += NC {
			mut jMax := jj + NC
			if jMax > yn {
				jMax = yn
			}

			// Middle loop: Iterate over inner dimension blocks (k dimension).
			mut kk := 0
			for kk < xn; kk += KC {
				mut kMax := kk + KC
				if kMax > xn {
					kMax = xn
				}

				// Inner loop: Iterate over row blocks of X and Z (i dimension).
				mut ii := 0
				for ii < xm; ii += MC {
					mut iMax := ii + MC
					if iMax > xm {
						iMax = xm
					}

					mut iLen := iMax - ii

					// Copy non-contiguous block of X into the contiguous stack buffer.
					// This resolves strided memory access issues and triggers hardware prefetching.
					mut kIdx := 0
					mut k := kk
					for k < kMax; k++ {
						xSlice := xPtr + (k * x.stride) + ii
						mut destPtr := pXPtr + (kIdx * iLen)

						// Scalar copy loop into pack buffer.
						mut i := 0
						for i < iLen; i++ {
							destPtr[i] = xSlice[i]
						}
						kIdx++
					}

					// Outer-product style execution over the packed buffer.
					// Uses 8-Way Scalar Unrolling to maximize
					// Instruction-Level Parallelism (ILP).
					mut j := jj
					for j < jMax; j++ {
						zm := j * z.stride
						ym := j * y.stride

						mut zOrigin := zPtr + zm + ii
						ySlice := yPtr + ym

						kIdx = 0
						k = kk
						for k < kMax; k++ {
							// Read contiguous X data directly from packed buffer
							// instead of strided memory.
							mut xPtrCurr := pXPtr + (kIdx * iLen)
							mut zPtrCurr := zOrigin

							// Broadcast scalar Y value across the inner compute loop.
							yVal := ySlice[k]
							mut i := 0

							// 8-Way Unrolled Main Loop.
							for i <= iLen-8; i += 8 {
								zPtrCurr[0] += xPtrCurr[0] * yVal
								zPtrCurr[1] += xPtrCurr[1] * yVal
								zPtrCurr[2] += xPtrCurr[2] * yVal
								zPtrCurr[3] += xPtrCurr[3] * yVal
								zPtrCurr[4] += xPtrCurr[4] * yVal
								zPtrCurr[5] += xPtrCurr[5] * yVal
								zPtrCurr[6] += xPtrCurr[6] * yVal
								zPtrCurr[7] += xPtrCurr[7] * yVal

								zPtrCurr += 8
								xPtrCurr += 8
							}

							// 2-Way Tail Loop for remaining elements.
							for i <= iLen-2; i += 2 {
								zPtrCurr[0] += xPtrCurr[0] * yVal
								zPtrCurr[1] += xPtrCurr[1] * yVal

								zPtrCurr += 2
								xPtrCurr += 2
							}

							// 1-Way Cleanup for odd remaining element.
							if i < iLen {
								zPtrCurr[0] += xPtrCurr[0] * yVal
							}

							kIdx++
						}
					}
				}
			}
		}
	}
}

// Just like `basicMul` but for matrix-view instead of Matrix.
#disable boundary
fn basicMulView[T](mut z: matrixView[T], mut x: matrixView[T], mut y: matrixView[T], flags: int) {
	// Initialize the destination matrix slice to zero.
	// Necessary because matrix views might refer to dirty memory segments.
	mut j := 0
	for j < y.n; j++ {
		zm := j * z.stride
		clear(z.data[zm : zm+x.m])
	}

	if flags&PARALLEL != 0 {
		basicMulView_Parallel(z, x, y)
	} else {
		basicMulView_Serial(z, x, y)
	}
}

// Threshold for switching to basic multiplication.
// This value is crucial for performance.
// Strassen algorithm is inefficient for tiny matrices.
const (
	strassenThreshold_Serial   = 64   // Threshold for serial computations.
	strassenThreshold_Parallel = 2048 // Threshold for parallel computations.
)

// Checks for Strassen algorithm, reports true if it makes sense.
fn checkStrassen(xm: int, xn: int, yn: int, flags: int): (max: int, useStrassen: bool) {
	// If the matrix size is small enough, use basic matrix multiplication.
	// This threshold balances recursion overhead and cache-local performance.
	// Threshold choice (e.g., 64) is crucial for performance and determines space needs.
	max = ibits::Max(ibits::Max(xm, xn), yn)
	// This condition equals to following code:
	//
	//	if flags&STRASSEN != 0 {
	//		if flags&PARALLEL != 0 {
	//			useStrassen = max >= strassenThreshold_Parallel
	//		} else {
	//			useStrassen = max >= strassenThreshold_Serial
	//		}
	//	}
	useStrassen = flags&STRASSEN != 0 &&
		(flags&PARALLEL != 0 && max >= strassenThreshold_Parallel ||
			flags&PARALLEL == 0 && max >= strassenThreshold_Serial)
	return
}

// Performs recursive Strassen matrix multiplication using single shared allocation.
// Assumes square matrices of size n × n where n is a power of 2.
// Writes final result to z, it must be have enough space for the product x*y.
#disable nilptr boundary
fn strassen[T: numeric](mut z: matrixView[T], mut x: matrixView[T], mut y: matrixView[T], mut space: []T, flags: int) {
	n, useStrassen := checkStrassen(x.m, x.n, y.n, flags)
	if !useStrassen {
		basicMulView(z, x, y, flags)
		return
	}

	// Half-size for quadrant splitting.
	k := n >> 1 // k = n / 2

	// Strassen requires 7 recursive multiplications and uses temporaries.
	// Allocate required submatrices from the workspace buffer:
	// - 7 intermediate result matrices (M1 through M7)
	// - 2 temporary matrices for sum/diff (S1, S2)
	// - 8 quadrant matrices (A11..A22, B11..B22) for copying subblocks

	// Allocate intermediate result matrices.
	mut m1 := getView(k, k, &space)
	mut m2 := getView(k, k, &space)
	mut m3 := getView(k, k, &space)
	mut m4 := getView(k, k, &space)
	mut m5 := getView(k, k, &space)
	mut m6 := getView(k, k, &space)
	mut m7 := getView(k, k, &space)

	mut s1 := getView(k, k, &space)
	mut s2 := getView(k, k, &space)

	// Allocate quadrant matrices from input x.
	mut a11 := x.getQuadrant(0, 0, k, k)
	mut a12 := x.getQuadrant(0, k, k, k)
	mut a21 := x.getQuadrant(k, 0, k, k)
	mut a22 := x.getQuadrant(k, k, k, k)

	// Allocate quadrant matrices from input y.
	mut b11 := y.getQuadrant(0, 0, k, k)
	mut b12 := y.getQuadrant(0, k, k, k)
	mut b21 := y.getQuadrant(k, 0, k, k)
	mut b22 := y.getQuadrant(k, k, k, k)

	// M1 = (A11 + A22) * (B11 + B22)
	addView(s1, a11, a22)
	addView(s2, b11, b22)
	strassen(m1, s1, s2, space, flags)

	// M2 = (A21 + A22) * B11
	addView(s1, a21, a22)
	strassen(m2, s1, b11, space, flags)

	// M3 = A11 * (B12 - B22)
	subView(s1, b12, b22)
	strassen(m3, a11, s1, space, flags)

	// M4 = A22 * (B21 - B11)
	subView(s1, b21, b11)
	strassen(m4, a22, s1, space, flags)

	// M5 = (A11 + A12) * B22
	addView(s1, a11, a12)
	strassen(m5, s1, b22, space, flags)

	// M6 = (A21 - A11) * (B11 + B12)
	subView(s1, a21, a11)
	addView(s2, b11, b12)
	strassen(m6, s1, s2, space, flags)

	// M7 = (A12 - A22) * (B21 + B22)
	subView(s1, a12, a22)
	addView(s2, b21, b22)
	strassen(m7, s1, s2, space, flags)

	// C11 = M1 + M4 - M5 + M7
	mut c11 := z.getQuadrant(0, 0, k, k)
	addView(c11, m1, m4)
	subView(c11, c11, m5)
	addView(c11, c11, m7)

	// C12 = M3 + M5
	mut c12 := z.getQuadrant(0, k, k, k)
	addView(c12, m3, m5)

	// C21 = M2 + M4
	mut c21 := z.getQuadrant(k, 0, k, k)
	addView(c21, m2, m4)

	// C22 = M1 - M2 + M3 + M6
	mut c22 := z.getQuadrant(k, k, k, k)
	subView(c22, m1, m2)
	addView(c22, c22, m3)
	addView(c22, c22, m6)
}

// Copies submatrix (of m × n) from source k at (a, b) to z.
// z must be have enough space to copy k.
#disable nilptr boundary
fn copySubMatrix[T: numeric](mut &z: *Matrix[T], &k: *Matrix[T], a: int, b: int, m: int, n: int) {
	if m <= 0 || n <= 0 {
		return
	}
	mut zm := 0 + 0*z.m           // i + j*z.m
	mut km := (a + 0) + (b+0)*k.m // (a + i) + (b+j)*k.m
	mut j := 0
	for j < n; j, zm, km = j+1, zm+z.m, km+k.m {
		copy(z.data[zm:zm+m], k.data[km:km+m])
	}
}

// Same as padAndCopy but for matrix-view.
#disable nilptr boundary
fn padAndCopyView[T: numeric](mut z: matrixView[T], &k: *Matrix[T]) {
	// Clear the z matrix if k is smaller than.
	if k.m < z.m || k.n < z.n {
		clear(z.data)
	}

	mut j := 0
	for j < k.n; j++ {
		zm := j * z.stride
		km := j * k.m
		copy(z.data[zm:zm+k.m], k.data[km:km+k.m])
	}
}

// Pads and copies k matrix into larger workspace matrix z.
// Fills remaining elements with zeros.
// z must be have enough space to copy k.
#disable nilptr boundary
fn padAndCopy[T: numeric](mut &z: *Matrix[T], &k: *Matrix[T]) {
	padAndCopyView(z.asView(), k)
}

// Returns new (M×N) matrix-view for type T from space.
// The result matrix-view will use shared data from space.
// Space will be trimmed according to size.
#disable nilptr boundary
fn getView[T: numeric](m: int, n: int, mut &space: *[]T): matrixView[T] {
	k := m * n
	if k > len(*space) {
		panic("mat: getMatrix: internal error, no space")
	}
	mut data := (*space)[:k]
	*space = (*space)[k:]
	return matrixView[T]{
		m:      m,
		n:      n,
		stride: m,
		data:   data,
	}
}