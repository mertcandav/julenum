use "std/math/big"

struct seqFactorial {
	mut n:   i64      // current n
	mut z:   big::Int // current factorial value (n!)
	mut tmp: big::Int // reusable temp for multiplying by n
}

impl Seq for seqFactorial {
	fn Reset(*self) {
		self.n = 0
		self.z.SetU64(0) // will be corrected on first Next()
	}

	fn Next(*self): big::Int {
		if self.n == 0 {
			// 0! = 1
			self.z.SetU64(1)
		} else {
			// tmp = n
			self.tmp.SetI64(self.n)

			// z = z * n
			self.z.Mul(&self.z, &self.tmp)
		}

		self.n++
		return self.z
	}
}

// Returns a sequence representing factorials from 0!, then 1!, 2!, and so on.
fn Factorial(): Seq {
	mut seq := new(seqFactorial)
	seq.Reset()
	return seq
}