use "std/math/big"

struct seqSquare {
	mut n:      big::Int // current n
	mut result: big::Int // reusable result buffer
	mut one:    big::Int // constant 1 (cached)
}

impl Seq for seqSquare {
	fn Reset(*self) {
		self.n.SetU64(1)
		self.one.SetU64(1)
	}

	fn Next(*self): big::Int {
		self.result.Mul(&self.n, &self.n) // result = n * n
		self.n.Add(&self.n, &self.one)    // n++
		return self.result
	}
}

// Returns a sequence representing square numbers from 1², then 2², 3², and so on.
fn Square(): Seq {
	mut seq := new(seqSquare)
	seq.Reset()
	return seq
}