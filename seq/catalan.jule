use "std/math/big"

struct seqCatalan {
	mut n:    i64      // current n
	mut c:    big::Int // current Catalan number C_n
	mut out:  big::Int // buffer to return stable pointer without allocations
	mut tmp1: big::Int // reusable temp
	mut tmp2: big::Int // reusable temp
}

impl Seq for seqCatalan {
	fn Reset(*self) {
		self.n = 0
		self.c.SetU64(1)
		self.out.SetU64(0)
		self.tmp1.SetU64(0)
		self.tmp2.SetU64(0)
	}

	fn Next(*self): big::Int {
		// copy current value into out so returned pointer is stable
		self.out.Set(&self.c)

		// compute next: c = c * (4n + 2) / (n + 2)
		// tmp1 = 4*n + 2
		self.tmp1.SetI64(4*self.n + 2)

		// c = c * tmp1  (in-place)
		self.c.Mul(&self.c, &self.tmp1)

		// tmp2 = n + 2
		self.tmp2.SetI64(self.n + 2)

		// c = c / tmp2  (exact division)
		self.c.Div(&self.c, &self.tmp2)

		// advance index
		self.n++

		ret self.out
	}
}

// Returns a sequence representing catalan numbers from C₀, then C₁, C₂, and so on.
fn Catalan(): Seq {
	mut seq := new(seqCatalan)
	seq.Reset()
	ret seq
}