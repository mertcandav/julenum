use "std/math/big"

struct seqCube {
	mut n:      big::Int // current n
	mut tmp:    big::Int // reusable temp: n^2
	mut result: big::Int // reusable result: n^3
}

impl Seq for seqCube {
	fn Reset(*self) {
		self.n.SetU64(1)
	}

	fn Next(*self): big::Int {
		// tmp = n * n        (n^2)
		self.tmp.Mul(&self.n, &self.n)

		// result = tmp * n  (n^3)
		self.result.Mul(&self.tmp, &self.n)

		// n++
		one := big::Int.New(1)
		self.n.Add(&self.n, &one)

		ret self.result
	}
}

// Returns a sequence representing cube numbers from 1³, then 2³, 3³, and so on.
fn Cube(): Seq {
	mut seq := new(seqCube)
	seq.Reset()
	ret seq
}