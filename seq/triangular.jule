use "std/math/big"

struct seqTriangular {
	mut n:       big::Int // current n
	mut tmp:     big::Int // reusable temp: n+1
	mut product: big::Int // reusable temp: n*(n+1)
	mut result:  big::Int // reusable result
}

impl Seq for seqTriangular {
	fn Reset(*self) {
		self.n.SetU64(1)
	}

	fn Next(*self): big::Int {
		one := big::Int.New(1)

		// tmp = n + 1
		self.tmp.Add(&self.n, &one)

		// product = n * (n + 1)
		self.product.Mul(&self.n, &self.tmp)

		// result = product >> 1  (divide by 2)
		self.result.Rsh(&self.product, 1)

		// n++
		self.n.Set(&self.tmp)

		ret self.result
	}
}

// Returns a sequence representing triangular numbers from 1, then 3, 6, 10, and so on.
fn Triangular(): Seq {
	mut seq := new(seqTriangular)
	seq.Reset()
	ret seq
}