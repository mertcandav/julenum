use "std/math/cmplx"

// pi*2
const pi2 = 6.28318530717958647692528676655900576839433879875021164194988918 // https://oeis.org/A000796

// Computes the discrete Fourier transform (DFT) of the given complex-valued slice
// using the in-place Cooley–Tukey radix-2 algorithm.
//
// If invert is true, it computes the inverse FFT (IFFT) instead.
// The input length must be a power of two; otherwise, the behavior is undefined.
//
// This function modifies the input slice in-place.
// For inverse FFT, results are scaled by 1/len.
#disable boundary
fn FFT(mut a: []cmplx128, invert: bool) {
	n := len(a)
	if n <= 1 {
		return
	}

	// Bit-reversal permutation.
	mut j := 0
	mut i := 1

	for i < n {
		mut bit := n >> 1

		for j&bit != 0 {
			j ^= bit
			bit >>= 1
		}

		j ^= bit

		if i < j {
			a[i], a[j] = a[j], a[i]
		}

		i++
	}

	// Cooley-Tukey radix-2 stages.
	mut length := 2

	for length <= n {
		half := length >> 1

		mut angle := pi2 / f64(length)
		if invert {
			angle = -angle
		}

		wlen := cmplx::Exp(cmplx(0, angle))

		i = 0
		for i < n {
			mut w := cmplx(1, 0)
			j = 0

			for j < half {
				left := i + j
				right := left + half

				u := a[left]
				v := a[right] * w

				a[left] = u + v
				a[right] = u - v

				w *= wlen
				j++
			}

			i += length
		}

		length <<= 1
	}

	if invert {
		// Complex division by a real number is more expensive than
		// multiplication by its reciprocal.
		invN := cmplx(1.0/f64(n), 0)

		i = 0
		for i < n; i++ {
			a[i] *= invN
		}
	}
}

// Computes FFT for a and b simultaneously.
//
// { FFT(a, invert); FFT(b, invert) } == FuseFFT(a, b, invert)
//
// Input lengths must be equal and powers of two.
// Both slices are modified in-place.
#disable boundary
fn FuseFFT(mut a: []cmplx128, mut b: []cmplx128, invert: bool) {
	n := len(a)

	if n != len(b) {
		panic("fourier: FuseFFT: slices must have equal length")
	}

	if n <= 1 {
		return
	}

	// Bit-reversal permutation.
	mut j := 0
	mut i := 1

	for i < n {
		mut bit := n >> 1

		for j&bit != 0 {
			j ^= bit
			bit >>= 1
		}

		j ^= bit

		if i < j {
			a[i], a[j] = a[j], a[i]
			b[i], b[j] = b[j], b[i]
		}

		i++
	}

	// Cooley-Tukey radix-2 stages.
	mut length := 2

	for length <= n {
		half := length >> 1

		mut angle := pi2 / f64(length)
		if invert {
			angle = -angle
		}

		wlen := cmplx::Exp(cmplx(0, angle))

		i = 0
		for i < n {
			mut w := cmplx(1, 0)
			j = 0

			for j < half {
				left := i + j
				right := left + half

				// Transform a.
				{
					u := a[left]
					v := a[right] * w

					a[left] = u + v
					a[right] = u - v
				}

				// Transform b.
				{
					u := b[left]
					v := b[right] * w

					b[left] = u + v
					b[right] = u - v
				}

				w *= wlen
				j++
			}

			i += length
		}

		length <<= 1
	}

	if invert {
		invN := 1.0 / f64(n)
		scale := cmplx(invN, 0)

		i = 0
		for i < n; i++ {
			a[i] *= scale
			b[i] *= scale
		}
	}
}