use "julenum/internal/fourier"

// Fast Fourier Transform and its inverse for real sequences.
struct RFFT {
	mut work: []f64
	mut ifac: [15]int

	// Temporarily store complex data as
	// pairs of real values to allow passing to
	// the backing code. The length of real
	// must always be half the length of work.
	mut real: []f64
}

impl RFFT {
	// Returns an RFFT initialized for work on sequences of length n.
	fn New(n: int): &RFFT {
		mut t := new(RFFT)
		t.Reset(n)
		return t
	}

	// Returns the length of the acceptable input.
	fn Len(*self): int { return len(self.real) }

	// Reinitializes the RFFT for work on sequences of length n.
	#disable boundary
	fn Reset(mut *self, n: int) {
		if 2*n <= cap(self.work) {
			self.work = self.work[:2*n]
			self.real = self.real[:n]
		} else {
			self.work = make([]f64, 2*n)
			self.real = make([]f64, n)
		}
		fourier::RFFTI(n, self.work, &self.ifac)
	}

	// Computes the Fourier coefficients of the input sequence,
	// converting the time series in seq into the frequency spectrum, placing
	// the result in dst and returning it. This transform is unnormalized; a
	// call to Coefficients followed by a call of Sequence will multiply the
	// input sequence by the length of the sequence.
	//
	// If the length of seq is not RFFT.Len(), Coefficients will panic.
	// If dst is nil, a new slice is allocated and returned. If dst is not nil and
	// the length of dst does not equal RFFT.Len()/2+1, Coefficients will panic.
	#disable boundary
	fn Coefficients(*self, mut dst: []cmplx128, seq: []f64): []cmplx128 {
		if len(seq) != self.Len() {
			panic("fourier: sequence length mismatch")
		}
		if dst == nil {
			dst = make([]cmplx128, self.Len()/2+1)
		} else if len(dst) != self.Len()/2+1 {
			panic("fourier: destination length mismatch")
		}
		copy(self.real, seq)
		fourier::RFFTF(len(self.real), self.real, self.work, &self.ifac)
		dst[0] = cmplx(self.real[0], 0)
		if len(seq) < 2 {
			return dst
		}
		if len(seq)%2 == 1 {
			dst[len(dst)-1] = cmplx(self.real[len(self.real)-2], self.real[len(self.real)-1])
		} else {
			dst[len(dst)-1] = cmplx(self.real[len(self.real)-1], 0)
		}
		mut i := 1
		for i < len(dst)-1; i++ {
			dst[i] = cmplx(self.real[2*i-1], self.real[2*i])
		}
		return dst
	}

	// Computes the real periodic sequence from the Fourier coefficients,
	// converting the frequency spectrum in coeff into a time series, placing the
	// result in dst and returning it. This transform is unnormalized; a call to
	// Coefficients followed by a call of Sequence will multiply the input sequence
	// by the length of the sequence.
	//
	// If the length of coeff is not RFFT.Len()/2+1, Sequence will panic.
	// If dst is nil, a new slice is allocated and returned. If dst is not nil and
	// the length of dst does not equal the length of coeff, Sequence will panic.
	#disable boundary
	fn Sequence(*self, mut dst: []f64, coeff: []cmplx128): []f64 {
		if len(coeff) != self.Len()/2+1 {
			panic("fourier: coefficients length mismatch")
		}
		if dst == nil {
			dst = make([]f64, self.Len())
		} else if len(dst) != self.Len() {
			panic("fourier: destination length mismatch")
		}
		dst[0] = real(coeff[0])
		if len(dst) < 2 {
			return dst
		}
		nf := coeff[len(coeff)-1]
		if len(dst)%2 == 1 {
			dst[len(dst)-2] = real(nf)
			dst[len(dst)-1] = imag(nf)
		} else {
			dst[len(dst)-1] = real(nf)
		}

		for i, cv in coeff[1 : len(coeff)-1] {
			dst[2*i+1] = real(cv)
			dst[2*i+2] = imag(cv)
		}
		fourier::RFFTB(len(dst), dst, self.work, &self.ifac)
		return dst
	}

	// Returns the relative frequency center for coefficient i.
	// Freq will panic if i is negative or greater than or equal to RFFT.Len().
	fn Freq(*self, i: int): f64 {
		if i < 0 || self.Len() <= i {
			panic("fourier: index out of range")
		}
		step := 1 / f64(self.Len())
		return step * f64(i)
	}
}